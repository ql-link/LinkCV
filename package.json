{
  "name": "linkcv",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "sync": "npm ci --prefix apps/web && uv sync --directory apps/backend --dev",
    "dev": "concurrently -n web,backend,legacy -c cyan,green,yellow \"npm:dev:web\" \"npm:dev:backend\" \"npm:dev:legacy\"",
    "dev:web": "npm --prefix apps/web run dev",
    "dev:backend": "uv run --directory apps/backend uvicorn linkcv.main:app --reload --host 127.0.0.1 --port ${BACKEND_PORT:-8000}",
    "dev:legacy": "node --env-file-if-exists=.env server/index.mjs",
    "build": "npm run build:web && npm run build:backend",
    "build:web": "npm --prefix apps/web run build",
    "build:backend": "uv build --directory apps/backend",
    "typecheck": "npm --prefix apps/web run typecheck",
    "test": "npm run test:backend",
    "test:backend": "uv run --directory apps/backend pytest",
    "check": "npm run typecheck && npm run build && npm run test:backend",
    "infra:up": "docker compose -f deploy/docker-compose.yml up -d",
    "infra:down": "docker compose -f deploy/docker-compose.yml down",
    "start:legacy": "NODE_ENV=production node --env-file-if-exists=.env server/index.mjs"
  },
  "dependencies": {
    "bcryptjs": "^3.0.3",
    "better-sqlite3": "^12.11.1",
    "cookie-parser": "^1.4.7",
    "express": "^5.2.1",
    "minio": "^8.0.7"
  },
  "devDependencies": {
    "concurrently": "^10.0.3"
  }
}
