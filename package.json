{
  "name": "linkcv",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "setup": "npm ci && npm run sync && npm run ai:setup",
    "sync": "npm ci --prefix apps/web && uv sync --directory apps/backend --dev",
    "ai:setup": "uv run --directory apps/backend python ../../scripts/setup/setup_ai_links.py",
    "check:ai": "uv run --directory apps/backend python ../../scripts/quality/check_ai_links.py && uv run --directory apps/backend python ../../scripts/quality/check_skills.py && npm run check:docs && npm run check:contracts",
    "check:docs": "uv run --directory apps/backend python ../../scripts/quality/check_docs_sync.py",
    "check:contracts": "uv run --directory apps/backend python ../../scripts/quality/check_runtime_contracts.py",
    "spec": "uv run --directory apps/backend python ../../scripts/spec/flow_guard.py",
    "spec:source": "uv run --directory apps/backend python ../../scripts/spec/source_guard.py",
    "dev": "concurrently -n web,backend,legacy -c cyan,green,yellow \"npm:dev:web\" \"npm:dev:backend\" \"npm:dev:legacy\"",
    "dev:web": "npm --prefix apps/web run dev",
    "dev:backend": "uv run --directory apps/backend uvicorn linkcv.main:app --reload --host 127.0.0.1 --port ${BACKEND_PORT:-8000}",
    "dev:legacy": "node --env-file-if-exists=.env server/index.mjs",
    "build": "npm run build:web && npm run build:backend",
    "build:web": "npm --prefix apps/web run build",
    "build:backend": "uv build --directory apps/backend",
    "typecheck": "npm --prefix apps/web run typecheck",
    "test": "npm run test:web && npm run test:backend",
    "test:web": "npm --prefix apps/web run test",
    "test:backend": "uv run --directory apps/backend pytest",
    "test:backend:unit": "uv run --directory apps/backend pytest tests/unit",
    "test:backend:integration": "uv run --directory apps/backend pytest tests/integration",
    "check:app": "npm run typecheck && npm run build && npm test",
    "check": "npm run check:ai && npm run check:app",
    "infra:up": "docker compose -f deploy/docker-compose.yml up -d",
    "infra:down": "docker compose -f deploy/docker-compose.yml down",
    "start:legacy": "NODE_ENV=production node --env-file-if-exists=.env server/index.mjs"
  },
  "dependencies": {
    "bcryptjs": "^3.0.3",
    "better-sqlite3": "^12.11.1",
    "cookie-parser": "^1.4.7",
    "express": "^5.2.1",
    "minio": "^8.0.7"
  },
  "devDependencies": {
    "concurrently": "^10.0.3"
  }
}
