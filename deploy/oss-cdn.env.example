# Copy to /opt/tolink/LinkResume/.env.oss-cdn.local on the Production host.
# The legacy filename is retained for deployment compatibility; this file now configures OSS only.
# Keep that file out of Git and set mode 600. Use a least-privilege RAM identity.
WEB_ASSET_OSS_BUCKET=
OSS_ACCESS_KEY_ID=
OSS_ACCESS_KEY_SECRET=
OSS_REGION=
# Optional. Leave empty to let ossutil derive the public endpoint from OSS_REGION.
OSS_ENDPOINT=
