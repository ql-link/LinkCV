# Production base configuration. Secrets belong in .env.production.local.
APP_ENV=production
BACKEND_HOST=0.0.0.0
BACKEND_PORT=8000
JWT_SECRET=
JWT_ALGORITHM=HS256
SESSION_COOKIE_NAME=resume_session
SESSION_TTL_DAYS=7
COOKIE_SECURE=true
ACCESS_TTL_MINUTES=15
ACCESS_COOKIE_NAME=resume_access
REFRESH_COOKIE_NAME=resume_refresh
LLM_CREDENTIAL_ENCRYPTION_KEYS=
LLM_TIMEOUT_SECONDS=60

MYSQL_HOST=tolink-mysql
MYSQL_PORT=3306
MYSQL_DATABASE=linkcv
MYSQL_USER=
MYSQL_PASSWORD=
DATABASE_URL=

REDIS_HOST=tolink-redis
REDIS_PORT=6379
REDIS_DB=0
REDIS_PASSWORD=
REDIS_URL=

MINIO_ENDPOINT=http://tolink-minio:9000
MINIO_ACCESS_KEY=
MINIO_SECRET_KEY=
MINIO_BUCKET=linkcv

RESUME_VERSION_LIMIT=10
RESUME_IMPORT_MAX_BYTES=10485760
RESUME_MARKDOWN_MAX_BYTES=2097152
RESUME_STRUCTURING_MAX_BYTES=131072
RESUME_IMPORT_REQUESTS_PER_MINUTE=3
RESUME_IMPORT_GLOBAL_CONCURRENCY=4
RESUME_IMPORT_USER_CONCURRENCY=1
RESUME_IMPORT_DEADLINE_SECONDS=120
RESUME_STRUCTURING_TIMEOUT_SECONDS=45
RESUME_IMPORT_IDEMPOTENCY_PROCESSING_TTL_SECONDS=180
RESUME_IMPORT_IDEMPOTENCY_SUCCESS_TTL_SECONDS=3600
RESUME_IMPORT_IDEMPOTENCY_FAILURE_TTL_SECONDS=60

LINKPARSE_BASE_URL=http://100.86.10.52:18743
LINKPARSE_API_KEY=
LINKPARSE_PARSE_PATH=/v1/parse
LINKPARSE_TIMEOUT_SECONDS=60
LINKPARSE_RESPONSE_MAX_BYTES=3145728
