# Production base configuration. Secrets belong in .env.production.local.
APP_ENV=production
BACKEND_HOST=0.0.0.0
BACKEND_PORT=8000
JWT_SECRET=
JWT_ALGORITHM=HS256
SESSION_COOKIE_NAME=resume_session
SESSION_TTL_DAYS=7
COOKIE_SECURE=true
LLM_CREDENTIAL_ENCRYPTION_KEYS=

MYSQL_HOST=tolink-mysql
MYSQL_PORT=3306
MYSQL_DATABASE=linkcv
MYSQL_USER=
MYSQL_PASSWORD=
DATABASE_URL=

REDIS_HOST=tolink-redis
REDIS_PORT=6379
REDIS_DB=0
REDIS_PASSWORD=
REDIS_URL=

MINIO_ENDPOINT=http://tolink-minio:9000
MINIO_ACCESS_KEY=
MINIO_SECRET_KEY=
MINIO_BUCKET=linkcv

RESUME_VERSION_LIMIT=10
RESUME_IMPORT_MAX_BYTES=10485760
RESUME_MARKDOWN_MAX_BYTES=2097152
RESUME_STRUCTURING_MAX_BYTES=131072
RESUME_IMPORT_REQUESTS_PER_MINUTE=3
RESUME_IMPORT_GLOBAL_CONCURRENCY=4
RESUME_IMPORT_USER_CONCURRENCY=1

RAG_BASE_URL=
RAG_API_KEY=
RAG_CONVERT_PATH=/documents/to-markdown
RAG_TIMEOUT_SECONDS=60

LLM_BASE_URL=
LLM_API_KEY=
LLM_MODEL=
LLM_STRUCTURED_PATH=/chat/completions
LLM_TIMEOUT_SECONDS=60
LLM_MAX_RETRIES=1

ALIYUN_OSS_ENDPOINT=
ALIYUN_OSS_REGION=
ALIYUN_OSS_ACCESS_KEY_ID=
ALIYUN_OSS_ACCESS_KEY_SECRET=
ALIYUN_OSS_BUCKET=
