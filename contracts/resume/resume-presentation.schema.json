{
  "$schema": "https://json-schema.org/draft/2020-12/schema", "$id": "resume-presentation.schema.json",
  "title": "ResumePresentationV1", "type": "object", "additionalProperties": false,
  "required": ["schema_version", "portable", "template_scoped", "template_snapshot"],
  "properties": {
    "schema_version": {"const": "resume-presentation.v1"},
    "portable": {"$ref": "#/$defs/settings"},
    "template_scoped": {"type": "object", "propertyNames": {"pattern": "^[a-z][a-z0-9-]{2,63}$"}, "patternProperties": {"^[a-z][a-z0-9-]{2,63}$": {"$ref": "#/$defs/settings"}}, "additionalProperties": false},
    "template_snapshot": {"$ref": "template-definition.schema.json"}
  },
  "$defs": {
    "settings": {"type": "object", "additionalProperties": false, "properties": {"smart_one_page": {"type": "boolean"}, "font_scale": {"type": "number", "minimum": 0.75, "maximum": 1.5}, "line_height": {"type": "number", "minimum": 1, "maximum": 3}, "accent_color": {"type": "string", "pattern": "^#[0-9A-Fa-f]{6}$"}, "page_margin_mm": {"type": "number", "minimum": 0, "maximum": 50}, "vertical_page_margin_mm": {"type": "number", "minimum": 0, "maximum": 50}, "page_margin_top_mm": {"type": "number", "minimum": 0, "maximum": 50}, "page_margin_right_mm": {"type": "number", "minimum": 0, "maximum": 50}, "page_margin_bottom_mm": {"type": "number", "minimum": 0, "maximum": 50}, "page_margin_left_mm": {"type": "number", "minimum": 0, "maximum": 50}, "avatar_size_px": {"type": "integer", "minimum": 48, "maximum": 240}, "sidebar_width_percent": {"type": "number", "minimum": 20, "maximum": 50}}}
  }
}
