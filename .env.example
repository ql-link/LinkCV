# FastAPI
APP_ENV=local
BACKEND_HOST=127.0.0.1
BACKEND_PORT=8000
JWT_SECRET=replace-with-at-least-32-random-characters
JWT_ALGORITHM=HS256
SESSION_COOKIE_NAME=resume_session
SESSION_TTL_DAYS=7
COOKIE_SECURE=false

# MySQL 8.4 development service
MYSQL_HOST=127.0.0.1
MYSQL_DATABASE=linkcv
MYSQL_USER=linkcv
MYSQL_PASSWORD=linkcv-local-change-me
MYSQL_ROOT_PASSWORD=linkcv-root-local-change-me
MYSQL_PORT=3306
DATABASE_URL=

# Redis development service (configuration only; no business cache consumer yet)
REDIS_HOST=127.0.0.1
REDIS_PORT=6379
REDIS_DB=0
REDIS_PASSWORD=linkcv-redis-local-change-me
REDIS_URL=

# MinIO development service and FastAPI client
MINIO_ENDPOINT=http://127.0.0.1:9000
MINIO_ACCESS_KEY=linkcv
MINIO_SECRET_KEY=linkcv-minio-local-change-me
MINIO_BUCKET=linkcv
MINIO_API_PORT=9000
MINIO_CONSOLE_PORT=9001

# Resume lifecycle and import limits
RESUME_VERSION_LIMIT=10
RESUME_IMPORT_MAX_BYTES=10485760
RESUME_MARKDOWN_MAX_BYTES=2097152
RESUME_STRUCTURING_MAX_BYTES=131072
RESUME_IMPORT_REQUESTS_PER_MINUTE=3
RESUME_IMPORT_GLOBAL_CONCURRENCY=4
RESUME_IMPORT_USER_CONCURRENCY=1

# tolink-rag file-to-Markdown adapter (optional until real integration is enabled)
RAG_BASE_URL=
RAG_API_KEY=
RAG_CONVERT_PATH=/documents/to-markdown
RAG_TIMEOUT_SECONDS=60

# OpenAI-compatible structured-output adapter (optional)
LLM_BASE_URL=
LLM_API_KEY=
LLM_MODEL=
LLM_STRUCTURED_PATH=/chat/completions
LLM_TIMEOUT_SECONDS=60
LLM_MAX_RETRIES=1

# Aliyun OSS reserved configuration (not used by the current MinIO storage client)
ALIYUN_OSS_ENDPOINT=
ALIYUN_OSS_REGION=
ALIYUN_OSS_ACCESS_KEY_ID=
ALIYUN_OSS_ACCESS_KEY_SECRET=
ALIYUN_OSS_BUCKET=
