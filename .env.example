# FastAPI
APP_ENV=local
BACKEND_HOST=127.0.0.1
BACKEND_PORT=8000
JWT_SECRET=replace-with-at-least-32-random-characters
JWT_ALGORITHM=HS256
SESSION_COOKIE_NAME=resume_session
SESSION_TTL_DAYS=7
COOKIE_SECURE=false
ACCESS_TTL_MINUTES=15
ACCESS_COOKIE_NAME=resume_access
REFRESH_COOKIE_NAME=resume_refresh

# 数据库加密保存的大模型凭据
# 格式为 keyId:FernetKey；轮换时把新密钥放在首位，并用逗号保留旧密钥
LLM_CREDENTIAL_ENCRYPTION_KEYS=

# MySQL 8.4 development service
MYSQL_HOST=127.0.0.1
MYSQL_DATABASE=linkcv
MYSQL_USER=linkcv
MYSQL_PASSWORD=linkcv-local-change-me
MYSQL_ROOT_PASSWORD=linkcv-root-local-change-me
MYSQL_PORT=3306
DATABASE_URL=

# 用于鉴权会话的 Redis 开发服务
REDIS_HOST=127.0.0.1
REDIS_PORT=6379
REDIS_DB=0
REDIS_PASSWORD=linkcv-redis-local-change-me
REDIS_URL=

# MinIO development service and FastAPI client
MINIO_ENDPOINT=http://127.0.0.1:9000
MINIO_ACCESS_KEY=linkcv
MINIO_SECRET_KEY=linkcv-minio-local-change-me
MINIO_BUCKET=linkcv
MINIO_API_PORT=9000
MINIO_CONSOLE_PORT=9001
PLUGIN_RELEASE_ORIGIN=http://127.0.0.1:5173

# Resume lifecycle and import limits
RESUME_VERSION_LIMIT=10
DATASET_UPLOAD_MAX_BYTES=10485760
RESUME_IMPORT_MAX_BYTES=10485760
RESUME_MARKDOWN_MAX_BYTES=2097152
RESUME_STRUCTURING_MAX_BYTES=131072
RESUME_IMPORT_REQUESTS_PER_MINUTE=3
RESUME_IMPORT_GLOBAL_CONCURRENCY=4
RESUME_IMPORT_USER_CONCURRENCY=1
RESUME_STRUCTURING_TIMEOUT_SECONDS=60
RESUME_IMPORT_UPLOAD_STALE_SECONDS=120
RESUME_IMPORT_PARSE_DEADLINE_SECONDS=180
RESUME_IMPORT_PARSE_STALE_SECONDS=240
RESUME_IMPORT_WORKER_LOCK_SECONDS=240
RESUME_IMPORT_IDEMPOTENCY_BIND_TTL_SECONDS=30
RESUME_IMPORT_IDEMPOTENCY_TTL_SECONDS=900
RESUME_IMPORT_WORKER_CONCURRENCY=4

# Asynchronous resume import broker. Local Compose provides RabbitMQ.
MQ_VENDOR=rabbitmq
RABBITMQ_URL=amqp://linkcv:linkcv-rabbit-local-change-me@127.0.0.1:5672/
RABBITMQ_EXCHANGE_NAME=tolink.cv.resume_import
RABBITMQ_QUEUE=linkcv.resume_import.worker
RABBITMQ_ROUTING_KEY=resume.import
KAFKA_BOOTSTRAP_SERVERS=
KAFKA_TOPIC=tolink.cv.resume_import
KAFKA_CONSUMER_GROUP=linkcv.resume_import.worker
MQ_PUBLISH_CONFIRM_TIMEOUT_SECONDS=5
MQ_CONSUME_MAX_RETRIES=2
MQ_CONSUME_RETRY_BACKOFF_SECONDS=1

# LinkParse PDF-to-Markdown service. Keep the API key in a gitignored .local file.
LINKPARSE_BASE_URL=http://100.86.10.52:18743
LINKPARSE_API_KEY=
LINKPARSE_PARSE_PATH=/v1/parse
LINKPARSE_TIMEOUT_SECONDS=90
LINKPARSE_RESPONSE_MAX_BYTES=3145728
DOCX_CONVERSION_TIMEOUT_SECONDS=30
REDIS_CONNECT_TIMEOUT_SECONDS=2
REDIS_SOCKET_TIMEOUT_SECONDS=2

# Unified managed LLM gateway timeout. Provider credentials live in MySQL.
LLM_TIMEOUT_SECONDS=75
