# FastAPI
APP_ENV=development
BACKEND_HOST=127.0.0.1
BACKEND_PORT=8000
JWT_SECRET=replace-with-at-least-32-random-characters
JWT_ALGORITHM=HS256
SESSION_COOKIE_NAME=resume_session
SESSION_TTL_DAYS=7
COOKIE_SECURE=false

# MySQL 8.4 development service
MYSQL_HOST=127.0.0.1
MYSQL_DATABASE=linkcv
MYSQL_USER=linkcv
MYSQL_PASSWORD=linkcv-local-change-me
MYSQL_ROOT_PASSWORD=linkcv-root-local-change-me
MYSQL_PORT=3306

# MinIO development service and FastAPI client
MINIO_ENDPOINT=http://127.0.0.1:9000
MINIO_ACCESS_KEY=linkcv
MINIO_SECRET_KEY=linkcv-minio-local-change-me
MINIO_BUCKET=linkcv
MINIO_API_PORT=9000
MINIO_CONSOLE_PORT=9001
