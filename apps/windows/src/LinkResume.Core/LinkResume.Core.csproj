<Project Sdk="Microsoft.NET.Sdk">
  <!-- 平台无关层：模型、API 协议与 mock、会话、导航。不引用任何 Windows 类型，可在 macOS / Linux CI 上编译和测试。 -->
  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <RootNamespace>LinkResume.Core</RootNamespace>
  </PropertyGroup>
  <ItemGroup>
    <EmbeddedResource Include="Resources\resume-templates.json" LogicalName="LinkResume.Core.resume-templates.json" />
  </ItemGroup>
  <ItemGroup>
    <PackageReference Include="CommunityToolkit.Mvvm" Version="8.4.2" />
  </ItemGroup>
</Project>
