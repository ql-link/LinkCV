<Page
    x:Class="DrawOffer.App.Views.SignInPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <StackPanel Width="360" Spacing="12" HorizontalAlignment="Center" VerticalAlignment="Center">
        <TextBlock Text="微信扫码登录 DrawOffer" Style="{StaticResource TitleTextBlockStyle}" />
        <Image x:Name="QrImage" Width="240" Height="240" />
        <TextBlock x:Name="StatusText" Text="使用微信扫码，并在手机上确认登录此 Windows。" TextWrapping="Wrap" />
        <TextBlock Text="{x:Bind Session.ErrorMessage, Mode=OneWay}" TextWrapping="Wrap" Foreground="{ThemeResource SystemFillColorCriticalBrush}" />
        <Button x:Name="LoginButton" Content="获取二维码 / 继续等待" Background="#17191C" Foreground="White" CornerRadius="8" FontSize="13" Click="OnSignIn" />
        <Button x:Name="NewQrButton" Content="重新生成二维码" Click="OnNewQr" />
        <Button Content="重试恢复登录" Click="OnRestore" />
        <Button Content="退出 / 清理登录" Click="OnSignOut" />
    </StackPanel>
</Page>
