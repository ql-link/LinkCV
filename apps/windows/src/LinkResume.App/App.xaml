<Application
    x:Class="LinkResume.App.App"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <Application.Resources>
        <ResourceDictionary>
            <ResourceDictionary.MergedDictionaries>
                <XamlControlsResources xmlns="using:Microsoft.UI.Xaml.Controls" />
            </ResourceDictionary.MergedDictionaries>
            <!-- 设计 Token，数值取自 apps/web/src/design-system/tokens.css；控件用系统 Fluent 外观 -->
            <SolidColorBrush x:Key="LinkResumeStageBrush" Color="#F3F2EF" />
            <SolidColorBrush x:Key="LinkResumeMutedBrush" Color="#6F7A8C" />
            <Color x:Key="LinkResumeAccentColor">#145ED6</Color>
        </ResourceDictionary>
    </Application.Resources>
</Application>
