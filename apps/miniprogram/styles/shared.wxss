/* 与 Web 落地页（apps/web/src/features/landing/landing.css）同源的视觉 Token。 */

page {
  --paper: #fafaf9;
  --ink: #18181b;
  --ink-soft: #71717a;
  --ink-faint: #a1a1aa;
  --hairline: rgba(0, 0, 0, 0.06);
  --accent: #355f85;
  --accent-soft: #edf4f8;
  --grid-line: rgba(0, 0, 0, 0.028);
  --font-display: Georgia, "Times New Roman", "Songti SC", "Noto Serif SC", serif;
  --font-body: -apple-system, BlinkMacSystemFont, "PingFang SC", "Microsoft YaHei", sans-serif;
  --font-mono: "SF Mono", Menlo, Consolas, "Courier New", monospace;
  background: var(--paper);
  color: var(--ink);
  font-family: var(--font-body);
  -webkit-font-smoothing: antialiased;
}

.canvas {
  position: relative;
  min-height: 100vh;
  padding: 0 48rpx calc(40rpx + env(safe-area-inset-bottom));
  box-sizing: border-box;
  overflow-x: hidden;
}

.canvas-grid {
  position: absolute;
  inset: 0;
  background-image:
    linear-gradient(to right, var(--grid-line) 1px, transparent 1px),
    linear-gradient(to bottom, var(--grid-line) 1px, transparent 1px);
  background-size: 144rpx 144rpx;
  pointer-events: none;
}

.topbar {
  position: relative;
  z-index: 1;
  height: 128rpx;
  display: flex;
  align-items: center;
}

.brand {
  display: flex;
  align-items: center;
  gap: 16rpx;
}

.brand-mark {
  width: 56rpx;
  height: 56rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  border-radius: 14rpx;
  background: var(--ink);
  color: #fff;
  font-family: var(--font-display);
  font-size: 30rpx;
  font-weight: 700;
}

.brand-copy {
  display: flex;
  flex-direction: column;
}

.brand-name {
  color: var(--ink);
  font-family: var(--font-display);
  font-size: 30rpx;
  font-weight: 600;
  letter-spacing: -1rpx;
  line-height: 1.15;
}

.brand-sub {
  margin-top: 4rpx;
  color: var(--ink-faint);
  font-family: var(--font-mono);
  font-size: 17rpx;
  letter-spacing: 4rpx;
}

.kicker {
  color: var(--ink-faint);
  font-family: var(--font-mono);
  font-size: 19rpx;
  letter-spacing: 8rpx;
}

.display-title {
  color: var(--ink);
  font-family: var(--font-display);
  font-weight: 500;
  letter-spacing: -2rpx;
  line-height: 1.15;
}

.body-copy {
  color: var(--ink-soft);
  font-size: 25rpx;
  line-height: 1.7;
}

.btn-primary,
.btn-ghost {
  width: 100%;
  height: 96rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  margin: 0;
  padding: 0 32rpx;
  border-radius: 999rpx;
  font-size: 27rpx;
  font-weight: 600;
  line-height: 96rpx;
  box-sizing: border-box;
  touch-action: manipulation;
}

.btn-primary {
  background: var(--ink);
  color: #fff;
  box-shadow: 0 16rpx 40rpx rgba(24, 24, 27, 0.18);
}

.btn-primary::after,
.btn-ghost::after {
  border: 0;
}

.btn-primary-pressed {
  background: #27272a;
  transform: translateY(1rpx);
}

.btn-primary[disabled],
.btn-ghost[disabled] {
  opacity: 0.5;
}

.btn-ghost {
  border: 2rpx solid var(--hairline);
  background: rgba(255, 255, 255, 0.72);
  color: var(--ink);
  font-weight: 500;
}

.btn-ghost-pressed {
  border-color: rgba(0, 0, 0, 0.2);
  background: #fff;
}

.paper-card {
  border: 1rpx solid var(--hairline);
  border-radius: 4rpx;
  background: #fff;
  box-shadow: 0 24rpx 60rpx rgba(24, 24, 27, 0.1), 0 2rpx 10rpx rgba(24, 24, 27, 0.04);
}

.footnote {
  position: relative;
  z-index: 1;
  color: var(--ink-faint);
  font-size: 20rpx;
  line-height: 1.6;
  text-align: center;
}
