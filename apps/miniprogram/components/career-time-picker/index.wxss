@import "../sheet-motion.wxss";
/* Based on Figma 125:223 with grouped month navigation and a full-width action. */
:host { font-family: "LinkCV Career UI", -apple-system, "PingFang SC", sans-serif; color: #17191c; }
.overlay { position: fixed; top: 0; right: 0; bottom: 0; left: 0; width: 100vw; height: 100vh; z-index: 1000001; }
.mask { position: absolute; top: 0; right: 0; bottom: 0; left: 0; background: rgba(0,0,0,.32); }
.picker-sheet { position: absolute; top: 145px; bottom: 0; left: 0; right: 0; display: flex; flex-direction: column; padding: 20px 20px 28px; background: #fff; border-radius: 22px 22px 0 0; box-sizing: border-box; overflow: hidden; }
.overlay .picker-button { display: flex; align-items: center; justify-content: center; flex-shrink: 0; box-sizing: border-box; width: auto; min-width: 0; max-width: none; height: auto; min-height: 0; margin: 0; padding: 0; border: 0; background: transparent; color: inherit; font-family: inherit; font-size: 14px; font-weight: 400; line-height: 20px; border-radius: 8px; }
.picker-button::after { border: 0; }
.header { display: flex; align-items: center; justify-content: space-between; height: 31px; flex-shrink: 0; margin-bottom: 16px; }
.title { display: flex; align-items: center; flex: 1; min-width: 0; height: 31px; font-size: 21px; line-height: 28px; font-weight: 400; }
.overlay .close { display: flex; align-items: center; justify-content: center; align-self: center; width: 24px; height: 31px; padding: 0; color: #6f7a8c; }
.close-glyph { display: block; height: 28px; font-family: Arial, sans-serif; font-size: 24px; font-weight: 400; line-height: 28px; }
.content { flex: 1; height: 0; min-height: 0; width: 100%; }
.stack { display: flex; flex-direction: column; width: 100%; }
.month { display: flex; align-items: flex-start; justify-content: flex-end; height: 28px; font-size: 17px; font-weight: 700; line-height: 23px; }
.month-actions { display: flex; align-items: center; gap: 8px; }
.month-label { min-width: 102px; text-align: center; white-space: nowrap; }
.overlay .month-action { width: 28px; height: 28px; color: #145ed6; font-size: 20px; }
.weekdays { display: flex; margin-top: 12px; height: 18px; color: #6f7a8c; font-size: 12px; line-height: 18px; text-align: center; }
.weekday { flex: 1; min-width: 0; }
.days { margin-top: 12px; }
.week { display: flex; width: 100%; }
.week + .week { margin-top: 4px; }
.overlay .day { flex: 1; width: 0; height: 32px; font-size: 14px; line-height: 20px; }
.overlay .day + .day { margin-left: 4px; }
.overlay .day.adjacent { color: #6f7a8c; }
.overlay .day.selected { background: #17191c; color: #fff; }
.hint { display: block; margin-top: 12px; font-size: 12px; line-height: 18px; color: #6f7a8c; }
.wheel-box { margin-top: 12px; padding: 0 24px; background: #f9fafb; border-radius: 12px; overflow: hidden; }
.wheel { display: block; height: 76px; width: 100%; }
.wheel-value { display: flex; align-items: center; justify-content: center; height: 28px; font-size: 12px; font-weight: 400; color: rgba(111,122,140,.45); line-height: 16px; }
.wheel-value.current { font-size: 22px; font-weight: 700; line-height: 28px; color: #17191c; }
.wheel-indicator::before, .wheel-indicator::after { border: 0; }
.wheel-mask { background: transparent; }
.footer { display: flex; align-items: center; justify-content: space-between; gap: 12px; height: 42px; margin-top: 16px; font-size: 14px; line-height: 20px; flex-shrink: 0; }
.overlay .confirm { width: 100%; height: 42px; background: #17191c; color: #fff; }
.overlay .confirm[disabled] { opacity: .45; }
.error { color: #c33333; font-size: 12px; line-height: 18px; margin-bottom: 12px; }
@media (max-height: 650px) { .picker-sheet { top: 80px; } }
