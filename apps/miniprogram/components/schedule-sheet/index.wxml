<view class="sheet-overlay" catchtouchmove="noop">
  <view class="sheet-mask mask-enter" bindtap="close" />
  <view class="sheet {{choosing ? 'sheet-enter' : 'form-enter'}}" role="dialog" aria-label="添加安排" aria-modal="true">
    <view class="sheet-header"><text class="sheet-title">{{choosing ? "添加安排" : "安排新阶段"}}</text><button class="sheet-button close-button" size="mini" bindtap="close" disabled="{{saving}}" aria-label="关闭添加安排">×</button></view>
    <scroll-view class="sheet-content" scroll-y enhanced show-scrollbar="{{false}}">
      <view class="content-stack {{choosing ? 'chooser-stack' : mode === 'stage' ? 'stage-stack' : 'schedule-stack'}}">
        <block wx:if="{{choosing}}">
          <view class="process-search"><view class="search-icon"><image class="search-glyph" src="/assets/career/sheet-search.svg" /></view><view class="field-input input-shell search-shell"><input class="native-input search-input" placeholder-class="search-placeholder" placeholder-style="width:100%;text-align:center;line-height:22px;" placeholder="搜索公司或岗位" aria-label="搜索公司或岗位" value="{{keyword}}" bindinput="search" maxlength="200" /></view></view>
          <text class="sheet-hint" wx:if="{{loading}}">正在加载求职流程…</text>
          <button size="mini" class="sheet-button process-option" wx:for="{{filtered}}" wx:key="id" data-id="{{item.id}}" bindtap="selectApplication" disabled="{{loading}}">
            <view class="process-identity">
              <text class="company">{{item.company_name_snapshot}}</text>
              <text class="process-job">{{item.job_title_snapshot}}</text>
            </view>
            <view class="process-progress">
              <text class="process-stage">{{item.stageLabel}}</text>
              <text class="process-stage-label">当前阶段</text>
            </view>
          </button>
          <text class="sheet-hint" wx:if="{{!loading && !error && !filtered.length}}">{{keyword ? '没有匹配的求职流程，试试其他关键词。' : '暂无可推进的求职流程。请先完成当前面试；如需给当前阶段补时间，请进入求职详情添加安排。'}}</text>
        </block>
        <block wx:else>
          <button size="mini" class="sheet-button process-selected" bindtap="changeApplication" disabled="{{saving || submissionStarted}}"><view class="selected-summary"><text class="selected-company">{{app.company_name_snapshot}}</text><text class="selected-job">{{app.job_title_snapshot}}</text></view><view class="change-label">重新选择</view></button>
          <view class="stage-types" wx:if="{{mode === 'stage'}}">
            <button size="mini" wx:for="{{types}}" wx:key="value" class="sheet-button stage-type {{form.stageType === item.value ? 'chosen' : ''}}" data-type="{{item.value}}" bindtap="selectType" disabled="{{saving || submissionStarted}}"><image class="stage-icon" src="/assets/career/sheet-{{item.value}}.svg" /><text>{{item.value === 'interview' ? '普通面试' : item.label}}</text></button>
          </view>
          <view class="field-group" wx:if="{{mode === 'stage' && form.stageType === 'interview'}}"><text class="field-label">新阶段名称 *</text><view class="field-input input-shell"><input class="native-input " placeholder-class="placeholder" placeholder="例如：技术二面、HR 面" value="{{form.stageLabel}}" data-field="stageLabel" bindinput="input" maxlength="100" disabled="{{saving || submissionStarted}}" /></view></view>
          <view class="field-group"><text class="field-label">{{form.stageType === 'interview' ? '面试时间 *' : '开始时间 *'}}</text><button size="mini" class="sheet-button field-input time-trigger" data-target="start" bindtap="chooseDateTime" disabled="{{saving || submissionStarted}}"><text class="time-value">{{startLabel}}</text><text class="time-action">选择时间</text></button></view>
          <view class="field-group" wx:if="{{form.stageType === 'interview'}}"><text class="field-label">时长</text><view class="duration-options"><button size="mini" wx:for="{{durationOptions}}" wx:key="*this" class="sheet-button duration-button {{!customDuration && duration == item ? 'active' : ''}}" data-minutes="{{item}}" bindtap="selectDuration" disabled="{{saving || submissionStarted}}">{{item}} 分钟</button><view class="duration-custom active" wx:if="{{customDuration}}"><input class="duration-input" type="number" value="{{duration}}" bindinput="inputDuration" maxlength="5" focus disabled="{{saving || submissionStarted}}" aria-label="自定义时长，分钟" /><text>分钟</text></view><button wx:else size="mini" class="sheet-button duration-button" data-minutes="custom" bindtap="selectDuration" disabled="{{saving || submissionStarted}}">自定义</button></view></view>
          <view class="field-group" wx:elif="{{form.stageType === 'assessment'}}"><text class="field-label">完成期限 *</text><view class="field-input input-shell"><input class="native-input" type="number" value="{{deadlineDays}}" bindinput="inputDeadline" maxlength="4" disabled="{{saving || submissionStarted}}" /><text>天</text></view></view>
          <view class="field-group" wx:else><text class="field-label">结束时间 *</text><button size="mini" class="sheet-button field-input time-trigger" data-target="end" bindtap="chooseDateTime" disabled="{{saving || submissionStarted}}"><text class="time-value">{{endLabel}}</text><text class="time-action">选择时间</text></button></view>
          <view class="field-group"><text class="field-label">{{form.stageType === 'interview' || form.stageType === 'ai_interview' ? '面试方式 *' : '安排方式 *'}}</text><career-select options="{{modes}}" value="{{form.modeIndex}}" data-field="modeIndex" bind:change="input" disabled="{{saving || submissionStarted}}" /></view>
          <view class="field-group">
            <text class="field-label">{{form.modeIndex == 0 || form.modeIndex == 2 ? '链接（选填）' : '地点（选填）'}}</text>
            <view class="field-input input-shell">
              <input wx:if="{{form.modeIndex == 0 || form.modeIndex == 2}}" class="native-input link-input" placeholder-class="placeholder" placeholder="粘贴会议链接或会议号" value="{{form.meetingUrl}}" data-field="meetingUrl" bindinput="input" maxlength="2048" disabled="{{saving || submissionStarted}}" />
              <input wx:else class="native-input" placeholder-class="placeholder" placeholder="填写地址或其他地点" value="{{form.location}}" data-field="location" bindinput="input" maxlength="500" disabled="{{saving || submissionStarted}}" />
            </view>
          </view>
        </block>
        <view class="feedback" wx:if="{{partial}}">{{partial}}</view>
        <view class="feedback error" wx:if="{{error}}">{{error}}</view>
        <button size="mini" wx:if="{{choosing && error}}" class="sheet-button retry" bindtap="loadApplications">重新加载</button>
        <text class="sheet-hint" wx:if="{{conflict}}">请关闭弹窗并刷新流程后重新添加。</text>
      </view>
    </scroll-view>
    <view class="sheet-footer" wx:if="{{!choosing}}"><button size="mini" class="sheet-button cancel-button" bindtap="close" disabled="{{saving}}">取消</button><button size="mini" class="sheet-button submit-button {{loading || saving || !app || conflict ? 'is-disabled' : ''}}" bindtap="save" loading="{{saving}}" disabled="{{loading || saving || !app || conflict}}">{{buttonLabel || '添加安排'}}</button></view>
  </view>
  <career-time-picker wx:if="{{timeEditorOpen}}" date="{{pickerDate}}" time="{{pickerTime}}" title="{{pickerTitle}}" error="{{error}}" bind:confirm="acceptDateTime" bind:close="cancelTimeEditor" />
</view>
