<view class="page" style="padding-top: {{statusBarHeight}}px">
  <view class="brand-row">
    <view class="ui-brand">
      <image class="ui-brand-wordmark" src="/assets/linkresume-wordmark.png" mode="aspectFit" aria-label="LinkResume"></image>
    </view>
  </view>

  <view class="loading-list" wx:if="{{loading}}">
    <view class="skeleton-row" wx:for="{{[1, 2, 3]}}" wx:key="*this">
      <view class="skeleton-icon"></view>
      <view class="skeleton-copy"><view class="skeleton-line strong"></view><view class="skeleton-line"></view></view>
    </view>
    <text class="loading-label">正在加载简历…</text>
  </view>
  <view class="state-card" wx:elif="{{guest}}">
    <text class="state-title">开启你的第一份创意简历</text>
    <text class="state-copy">随时随地查阅你的职业档案，让每一次展示都专业出彩。</text>
    <button class="state-action" hover-class="state-action-pressed" bindtap="goLogin">微信一键登录</button>
  </view>
  <view class="state-card" wx:elif="{{error}}">
    <text class="state-title">简历暂时没有加载出来</text>
    <text class="state-copy">{{error}}，请检查网络后重试。</text>
    <button class="state-ghost" hover-class="state-ghost-pressed" bindtap="loadPage">重新加载</button>
  </view>
  <view class="state-card" wx:elif="{{items.length === 0}}">
    <text class="state-title">这里还没有简历</text>
    <text class="state-copy">前往 LinkResume 网页端自由编辑与排版，多端实时同步查阅。</text>
  </view>
  <view class="resume-list" wx:else>
    <navigator
      class="resume-card"
      hover-class="resume-card-pressed"
      hover-stay-time="70"
      wx:for="{{items}}"
      wx:key="id"
      url="/pages/resumes/detail?id={{item.id}}"
    >
      <!-- 左侧高质感文档标识 -->
      <view class="doc-badge-wrap" aria-hidden="true">
        <view class="doc-badge-paper">
          <view class="badge-line l1"></view>
          <view class="badge-line l2"></view>
          <view class="badge-line l3"></view>
        </view>
        <view class="doc-badge-tag">CV</view>
      </view>

      <!-- 中间简历信息 -->
      <view class="resume-info">
        <text class="resume-title">{{item.title}}</text>
        <view class="resume-meta-row">
          <text class="resume-time">{{item.updatedAtLabel}}</text>
          <view class="resume-status-tag">
            <text class="status-dot"></text>
            <text>可查阅</text>
          </view>
        </view>
      </view>

      <!-- 右侧轻操作按钮 -->
      <view class="resume-arrow-wrap">
        <text class="resume-arrow">›</text>
      </view>
    </navigator>
  </view>
</view>
