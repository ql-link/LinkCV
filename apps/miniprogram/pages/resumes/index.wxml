<view class="page" style="padding-top: {{statusBarHeight}}px">
  <view class="brand-row">
    <view class="ui-brand">
      <image class="ui-brand-wordmark" src="/assets/linkresume-wordmark.png" mode="aspectFit" aria-label="LinkResume"></image>
    </view>
  </view>
  <view class="page-head">
    <view class="page-title-row">
      <text class="page-title" wx:if="{{user && user.nickname}}">{{user.nickname}}的简历</text>
      <text class="page-title" wx:else>我的简历</text>
      <navigator class="profile-entry" open-type="switchTab" url="/pages/profile/index" wx:if="{{!guest}}">我的 ›</navigator>
    </view>
    <view class="page-meta-row" wx:if="{{!loading && !error && !guest}}">
      <text class="page-meta">{{items.length}} 份简历 · 下拉可刷新</text>
      <text class="readonly-tag">只读</text>
    </view>
  </view>

  <view class="loading-list" wx:if="{{loading}}">
    <view class="skeleton-row" wx:for="{{[1, 2, 3]}}" wx:key="*this">
      <view class="skeleton-icon"></view>
      <view class="skeleton-copy"><view class="skeleton-line strong"></view><view class="skeleton-line"></view></view>
    </view>
    <text class="loading-label">正在加载简历…</text>
  </view>
  <view class="state-card" wx:elif="{{guest}}">
    <text class="state-title">登录后查看你的简历</text>
    <text class="state-copy">简历数据只在登录后加载。登录后即可查看你在网页端创建的简历。</text>
    <button class="state-action" hover-class="state-action-pressed" bindtap="goLogin">微信登录</button>
  </view>
  <view class="state-card" wx:elif="{{error}}">
    <text class="state-title">简历暂时没有加载出来</text>
    <text class="state-copy">{{error}}，请检查网络后重试。</text>
    <button class="state-ghost" hover-class="state-ghost-pressed" bindtap="loadPage">重新加载</button>
  </view>
  <view class="state-card" wx:elif="{{items.length === 0}}">
    <text class="state-title">这里还没有简历</text>
    <text class="state-copy">请先前往 LinkResume 网页端创建简历，完成后下拉刷新。</text>
  </view>
  <view class="resume-list" wx:else>
    <navigator class="resume-item" hover-class="resume-item-pressed" hover-stay-time="80" wx:for="{{items}}" wx:key="id" url="/pages/resumes/detail?id={{item.id}}">
      <view class="item-icon" aria-hidden="true">
        <view class="icon-line"></view>
        <view class="icon-line is-short"></view>
        <view class="icon-line"></view>
      </view>
      <view class="item-copy">
        <text class="item-title">{{item.title}}</text>
        <text class="item-time">{{item.updatedAtLabel}}</text>
      </view>
      <text class="item-arrow">›</text>
    </navigator>
  </view>
  <text class="page-footnote" wx:if="{{!loading && !error && items.length}}">小程序仅供查阅 · 编辑请前往网页端</text>
</view>
