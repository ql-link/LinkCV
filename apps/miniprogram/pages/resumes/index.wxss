.page {
  min-height: 100vh;
  padding: 0 32rpx calc(52rpx + env(safe-area-inset-bottom));
  box-sizing: border-box;
}

.topbar {
  height: 116rpx;
  display: flex;
  align-items: center;
  justify-content: space-between;
}

.readonly-tag {
  padding: 8rpx 18rpx;
  border: 1rpx solid var(--ui-border);
  border-radius: 999rpx;
  color: var(--ui-text-muted);
  font-size: 20rpx;
}

.page-head {
  display: flex;
  flex-direction: column;
  padding: 8rpx 8rpx 28rpx;
}

.page-title {
  color: var(--ui-foreground);
  font-size: 44rpx;
  font-weight: 650;
  letter-spacing: -1rpx;
  line-height: 1.3;
  word-break: break-all;
}

.page-meta {
  display: flex;
  align-items: center;
  margin-top: 14rpx;
  color: var(--ui-text-muted);
  font-size: 22rpx;
}

.meta-divider {
  margin: 0 12rpx;
  color: var(--ui-border-strong);
}

.card-list {
  display: flex;
  flex-direction: column;
  gap: 22rpx;
}

.resume-card {
  display: flex;
  flex-direction: column;
  overflow: hidden;
  border: 1rpx solid var(--ui-border);
  border-radius: 24rpx;
  background: var(--ui-surface);
  touch-action: manipulation;
}

.resume-card-pressed {
  border-color: var(--ui-border-strong);
  box-shadow: var(--ui-shadow-md);
}

.card-preview {
  display: flex;
  align-items: center;
  justify-content: center;
  padding: 30rpx 0 26rpx;
  border-bottom: 1rpx solid var(--ui-border);
  background: var(--ui-surface-subtle);
}

.card-document {
  width: 172rpx;
  padding: 20rpx 18rpx;
  border: 1rpx solid var(--ui-border-strong);
  border-radius: 8rpx;
  background: var(--ui-surface);
  box-shadow: var(--ui-shadow-sm);
}

.doc-title {
  width: 48%;
  height: 11rpx;
  margin-bottom: 13rpx;
  border-radius: 999rpx;
  background: var(--ui-foreground);
}

.doc-line {
  height: 7rpx;
  margin-top: 11rpx;
  border-radius: 999rpx;
  background: var(--ui-border-strong);
}

.doc-line.is-short {
  width: 66%;
}

.card-meta {
  display: flex;
  flex-direction: column;
  padding: 20rpx 24rpx 22rpx;
  background: var(--ui-surface);
}

.card-name {
  overflow: hidden;
  color: var(--ui-foreground);
  font-size: 28rpx;
  font-weight: 600;
  text-overflow: ellipsis;
  white-space: nowrap;
}

.card-time {
  margin-top: 6rpx;
  overflow: hidden;
  color: var(--ui-text-muted);
  font-size: 22rpx;
  text-overflow: ellipsis;
  white-space: nowrap;
}

.card-open {
  margin-top: 18rpx;
  color: var(--ui-accent);
  font-size: 23rpx;
  font-weight: 600;
}

.loading-list {
  display: flex;
  flex-direction: column;
  gap: 22rpx;
}

.skeleton-card {
  height: 168rpx;
  display: flex;
  align-items: center;
  padding: 24rpx;
  border: 1rpx solid var(--ui-border);
  border-radius: 24rpx;
  background: var(--ui-surface);
  box-sizing: border-box;
}

.skeleton-preview {
  width: 96rpx;
  height: 120rpx;
  flex-shrink: 0;
  border-radius: 8rpx;
  background: var(--ui-surface-muted);
}

.skeleton-copy {
  flex: 1;
  margin-left: 26rpx;
}

.skeleton-line {
  width: 58%;
  height: 14rpx;
  margin-top: 18rpx;
  border-radius: 10rpx;
  background: var(--ui-surface-muted);
}

.skeleton-line.strong {
  width: 76%;
  height: 20rpx;
  margin-top: 0;
}

.loading-label {
  margin-top: 8rpx;
  color: var(--ui-text-muted);
  font-size: 21rpx;
  text-align: center;
}

.state-card {
  display: flex;
  flex-direction: column;
  align-items: center;
  justify-content: center;
  min-height: 420rpx;
  padding: 48rpx 44rpx;
  border: 1rpx solid var(--ui-border);
  border-radius: 24rpx;
  background: var(--ui-surface);
  box-sizing: border-box;
  text-align: center;
}

.state-title {
  color: var(--ui-foreground);
  font-size: 30rpx;
  font-weight: 600;
}

.state-copy {
  max-width: 480rpx;
  margin-top: 14rpx;
  color: var(--ui-text-muted);
  font-size: 23rpx;
  line-height: 1.7;
}

.state-action {
  width: 340rpx;
  margin-top: 30rpx;
}

.page-footnote {
  display: block;
  margin-top: 34rpx;
  color: var(--ui-text-subtle);
  font-size: 20rpx;
  text-align: center;
}
