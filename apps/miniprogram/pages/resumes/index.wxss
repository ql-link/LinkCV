@import "../../styles/shared.wxss";

.canvas {
  padding: 0 40rpx calc(56rpx + env(safe-area-inset-bottom));
}

.hero {
  position: relative;
  z-index: 1;
  display: flex;
  flex-direction: column;
}

.topbar {
  height: 128rpx;
  display: flex;
  align-items: center;
  justify-content: space-between;
}

.readonly-tag {
  padding: 8rpx 18rpx;
  border: 1rpx solid var(--hairline);
  border-radius: 999rpx;
  color: var(--ink-faint);
  font-family: var(--font-mono);
  font-size: 17rpx;
  letter-spacing: 4rpx;
}

.hero-kicker {
  margin-top: 8rpx;
}

.hero-title {
  margin-top: 20rpx;
  font-size: 56rpx;
  word-break: break-all;
}

.hero-meta {
  display: flex;
  align-items: center;
  margin-top: 18rpx;
  color: var(--ink-faint);
  font-family: var(--font-mono);
  font-size: 20rpx;
  letter-spacing: 2rpx;
}

.meta-divider {
  margin: 0 12rpx;
  color: var(--hairline);
}

.list {
  position: relative;
  z-index: 1;
  display: flex;
  flex-direction: column;
  gap: 20rpx;
  margin-top: 36rpx;
}

.card {
  display: flex;
  align-items: center;
  padding: 28rpx 26rpx;
  box-sizing: border-box;
  touch-action: manipulation;
}

.card-pressed {
  background: #fafaf7;
  transform: scale(0.992);
}

.paper-preview {
  width: 92rpx;
  height: 116rpx;
  flex-shrink: 0;
  padding: 17rpx 14rpx;
  border: 1rpx solid rgba(24, 24, 27, 0.1);
  border-radius: 2rpx;
  background: linear-gradient(150deg, #fff 0%, #f7f7f5 100%);
  box-sizing: border-box;
}

.preview-avatar {
  width: 22rpx;
  height: 22rpx;
  border-radius: 50%;
  background: var(--ink);
}

.preview-line {
  width: 100%;
  height: 5rpx;
  margin-top: 12rpx;
  border-radius: 4rpx;
  background: #e4e4e7;
}

.preview-line-strong {
  width: 72%;
  background: #a1a1aa;
}

.preview-line-short {
  width: 56%;
}

.card-main {
  min-width: 0;
  flex: 1;
  display: flex;
  flex-direction: column;
  margin-left: 28rpx;
}

.card-title {
  overflow: hidden;
  color: var(--ink);
  font-family: var(--font-display);
  font-size: 31rpx;
  font-weight: 600;
  letter-spacing: -1rpx;
  text-overflow: ellipsis;
  white-space: nowrap;
}

.card-time {
  margin-top: 10rpx;
  overflow: hidden;
  color: var(--ink-faint);
  font-family: var(--font-mono);
  font-size: 19rpx;
  letter-spacing: 1rpx;
  text-overflow: ellipsis;
  white-space: nowrap;
}

.card-action {
  margin-top: 16rpx;
  color: var(--accent);
  font-size: 22rpx;
  font-weight: 600;
}

.loading-list {
  position: relative;
  z-index: 1;
  display: flex;
  flex-direction: column;
  gap: 20rpx;
  margin-top: 36rpx;
}

.skeleton-card {
  height: 172rpx;
  display: flex;
  align-items: center;
  padding: 26rpx 24rpx;
  border: 1rpx solid var(--hairline);
  border-radius: 4rpx;
  background: rgba(255, 255, 255, 0.6);
  box-sizing: border-box;
}

.skeleton-preview {
  width: 92rpx;
  height: 116rpx;
  flex-shrink: 0;
  border-radius: 2rpx;
  background: #ededec;
}

.skeleton-copy {
  flex: 1;
  margin-left: 28rpx;
}

.skeleton-line {
  width: 58%;
  height: 14rpx;
  margin-top: 18rpx;
  border-radius: 10rpx;
  background: #ededec;
}

.skeleton-line.strong {
  width: 76%;
  height: 20rpx;
  margin-top: 0;
}

.loading-label {
  margin-top: 8rpx;
  color: var(--ink-faint);
  font-size: 21rpx;
  text-align: center;
}

.state-card {
  position: relative;
  z-index: 1;
  display: flex;
  flex-direction: column;
  align-items: center;
  justify-content: center;
  margin-top: 36rpx;
  min-height: 420rpx;
  padding: 48rpx 44rpx;
  box-sizing: border-box;
  text-align: center;
}

.state-kicker {
  color: var(--ink-faint);
  font-family: var(--font-mono);
  font-size: 18rpx;
  letter-spacing: 8rpx;
}

.state-kicker-error {
  color: #c43b3b;
}

.state-title {
  margin-top: 22rpx;
  color: var(--ink);
  font-family: var(--font-display);
  font-size: 34rpx;
  font-weight: 600;
  letter-spacing: -1rpx;
}

.state-copy {
  max-width: 480rpx;
  margin-top: 16rpx;
  color: var(--ink-soft);
  font-size: 23rpx;
  line-height: 1.7;
}

.state-action {
  width: 320rpx;
  margin-top: 34rpx;
}

.page-footnote {
  position: relative;
  z-index: 1;
  display: block;
  margin-top: 36rpx;
  color: var(--ink-faint);
  font-size: 20rpx;
  letter-spacing: 1rpx;
  text-align: center;
}
