.page {
  min-height: 100vh;
  display: flex;
  flex-direction: column;
  padding: 0 32rpx calc(48rpx + env(safe-area-inset-bottom));
  box-sizing: border-box;
}

.brand-row {
  height: 116rpx;
  display: flex;
  align-items: center;
}

.page-meta-row {
  display: flex;
  align-items: center;
  justify-content: space-between;
  margin-top: 12rpx;
}

.readonly-tag {
  padding: 6rpx 16rpx;
  border: 1rpx solid var(--ui-border);
  border-radius: 999rpx;
  color: var(--ui-text-muted);
  font-size: 19rpx;
}

.page-head {
  padding: 8rpx 8rpx 26rpx;
}

.page-title-row {
  display: flex;
  align-items: baseline;
  justify-content: space-between;
  gap: 16rpx;
}

.profile-entry {
  flex-shrink: 0;
  color: var(--ui-accent);
  font-size: 23rpx;
  font-weight: 600;
}

.page-title {
  color: var(--ui-foreground);
  font-size: 44rpx;
  font-weight: 700;
  letter-spacing: -1rpx;
  line-height: 1.3;
  word-break: break-all;
}

.page-meta {
  color: var(--ui-text-muted);
  font-size: 22rpx;
}

.resume-list {
  display: flex;
  flex-direction: column;
  gap: 16rpx;
}

.resume-item {
  display: flex;
  align-items: center;
  padding: 24rpx 24rpx;
  border: 1rpx solid var(--ui-border);
  border-radius: 18rpx;
  background: var(--ui-surface);
  touch-action: manipulation;
}

.resume-item-pressed {
  background: var(--ui-surface-subtle);
}

.item-icon {
  width: 56rpx;
  height: 68rpx;
  flex-shrink: 0;
  padding: 10rpx 10rpx;
  border: 1rpx solid var(--ui-border);
  border-radius: 8rpx;
  box-sizing: border-box;
}

.icon-line {
  height: 5rpx;
  border-radius: 4rpx;
  background: var(--ui-border-strong);
}

.icon-line:first-child {
  width: 60%;
  margin-bottom: 8rpx;
  background: var(--ui-text-subtle);
}

.icon-line.is-short {
  width: 70%;
  margin: 8rpx 0;
}

.item-copy {
  min-width: 0;
  flex: 1;
  display: flex;
  flex-direction: column;
  margin-left: 24rpx;
}

.item-title {
  overflow: hidden;
  color: var(--ui-foreground);
  font-size: 28rpx;
  font-weight: 600;
  text-overflow: ellipsis;
  white-space: nowrap;
}

.item-time {
  margin-top: 6rpx;
  overflow: hidden;
  color: var(--ui-text-muted);
  font-size: 21rpx;
  text-overflow: ellipsis;
  white-space: nowrap;
}

.item-arrow {
  flex-shrink: 0;
  margin-left: 16rpx;
  color: var(--ui-text-subtle);
  font-size: 36rpx;
  line-height: 1;
}

.loading-list {
  flex: 1;
  display: flex;
  flex-direction: column;
  justify-content: center;
  gap: 16rpx;
  padding: 80rpx 0;
}

.skeleton-row {
  display: flex;
  align-items: center;
  padding: 24rpx;
  border: 1rpx solid var(--ui-border);
  border-radius: 18rpx;
  background: var(--ui-surface);
}

.skeleton-icon {
  width: 56rpx;
  height: 68rpx;
  flex-shrink: 0;
  border-radius: 8rpx;
  background: var(--ui-surface-muted);
}

.skeleton-copy {
  flex: 1;
  margin-left: 24rpx;
}

.skeleton-line {
  width: 56%;
  height: 13rpx;
  margin-top: 14rpx;
  border-radius: 8rpx;
  background: var(--ui-surface-muted);
}

.skeleton-line.strong {
  width: 74%;
  height: 18rpx;
  margin-top: 0;
}

.loading-label {
  margin-top: 6rpx;
  color: var(--ui-text-muted);
  font-size: 21rpx;
  text-align: center;
}

.state-card {
  flex: 1;
  display: flex;
  flex-direction: column;
  align-items: center;
  justify-content: center;
  min-height: 480rpx;
  margin: auto 0;
  padding: 56rpx 44rpx;
  border: 1rpx solid var(--ui-border);
  border-radius: 24rpx;
  background: var(--ui-surface);
  box-shadow: 0 4rpx 20rpx -4rpx rgba(15, 23, 42, 0.04);
  box-sizing: border-box;
  text-align: center;
}

.state-title {
  color: var(--ui-foreground);
  font-size: 32rpx;
  font-weight: 600;
}

.state-copy {
  max-width: 520rpx;
  margin-top: 14rpx;
  color: var(--ui-text-muted);
  font-size: 24rpx;
  line-height: 1.7;
}

.state-action {
  width: 340rpx;
  height: 88rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  margin: 36rpx 0 0;
  padding: 0 28rpx;
  border-radius: 18rpx;
  background: var(--ui-accent);
  color: #fff;
  font-size: 27rpx;
  font-weight: 600;
  line-height: 88rpx;
  box-sizing: border-box;
  touch-action: manipulation;
}

.state-action::after,
.state-ghost::after {
  border: 0;
}

.state-action-pressed {
  background: var(--ui-accent-hover);
}

.state-ghost {
  width: 320rpx;
  height: 84rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  margin: 32rpx 0 0;
  padding: 0 28rpx;
  border: 1rpx solid var(--ui-border-strong);
  border-radius: 16rpx;
  background: var(--ui-secondary);
  color: var(--ui-secondary-foreground);
  font-size: 26rpx;
  font-weight: 600;
  line-height: 84rpx;
  box-sizing: border-box;
  touch-action: manipulation;
}

.state-ghost-pressed {
  background: var(--ui-secondary-hover);
}

.page-footnote {
  display: block;
  margin-top: 30rpx;
  color: var(--ui-text-subtle);
  font-size: 20rpx;
  text-align: center;
}
