@import "../../styles/shared.wxss";

.page {
  min-height: 100vh;
  padding: 28rpx 32rpx calc(48rpx + env(safe-area-inset-bottom));
  box-sizing: border-box;
}

.preview-state {
  min-height: 70vh;
  display: flex;
  flex-direction: column;
  align-items: center;
  justify-content: center;
  padding: 48rpx 44rpx;
  border: 1rpx solid var(--hairline);
  border-radius: 4rpx;
  background: rgba(255, 255, 255, 0.6);
  box-sizing: border-box;
  text-align: center;
}

.state-kicker {
  margin-top: 26rpx;
  color: var(--ink-faint);
  font-family: var(--font-mono);
  font-size: 18rpx;
  letter-spacing: 8rpx;
}

.state-kicker-error {
  color: #c43b3b;
}

.state-title {
  margin-top: 18rpx;
  color: var(--ink);
  font-family: var(--font-display);
  font-size: 32rpx;
  font-weight: 600;
  letter-spacing: -1rpx;
}

.state-copy {
  max-width: 480rpx;
  margin-top: 14rpx;
  color: var(--ink-soft);
  font-size: 23rpx;
  line-height: 1.7;
}

.state-action {
  width: 340rpx;
  margin-top: 20rpx;
}

.state-action:first-of-type {
  margin-top: 34rpx;
}

.spinner {
  width: 40rpx;
  height: 40rpx;
  border: 3rpx solid rgba(24, 24, 27, 0.12);
  border-top-color: var(--ink);
  border-radius: 50%;
  animation: spin 0.8s linear infinite;
}

@keyframes spin {
  to { transform: rotate(360deg); }
}

@media (prefers-reduced-motion: reduce) {
  .spinner { animation: none; }
}

.preview-document {
  display: flex;
  flex-direction: column;
  align-items: center;
}

.preview-paper {
  width: 100%;
  border: 1rpx solid var(--hairline);
  border-radius: 4rpx;
  background: #fff;
  box-shadow: 0 24rpx 60rpx rgba(24, 24, 27, 0.1), 0 2rpx 10rpx rgba(24, 24, 27, 0.04);
  overflow: hidden;
}

.resume-preview-image {
  display: block;
  width: 100%;
}

.preview-footnote {
  margin-top: 26rpx;
  color: var(--ink-faint);
  font-family: var(--font-mono);
  font-size: 18rpx;
  letter-spacing: 3rpx;
}
