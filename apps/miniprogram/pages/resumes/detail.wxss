.preview-state {
  min-height: 100vh;
  display: flex;
  flex-direction: column;
  align-items: center;
  justify-content: center;
  padding: 64rpx;
  box-sizing: border-box;
  text-align: center;
}
.spinner {
  width: 44rpx;
  height: 44rpx;
  margin-bottom: 24rpx;
  border: 4rpx solid var(--ui-border);
  border-top-color: var(--ui-foreground);
  border-radius: 50%;
  animation: spin .8s linear infinite;
}
.preview-state > text { color: var(--ui-text-muted); font-size: 25rpx; }
.state-title { color: var(--ui-foreground) !important; font-size: 32rpx !important; font-weight: 600; }
.state-copy { max-width: 560rpx; margin-top: 18rpx; line-height: 1.6; }
.state-action { min-width: 260rpx; margin-top: 36rpx; }
.back-action { margin-top: 24rpx; padding: 12rpx 24rpx; color: var(--ui-text-muted); background: transparent; font-size: 24rpx; }
.back-action::after { border: 0; }
@keyframes spin { to { transform: rotate(360deg); } }
.preview-document {
  min-height: 100vh;
  padding: 20rpx;
  box-sizing: border-box;
  background: #e9edf2;
}
.resume-preview-image {
  display: block;
  width: 100%;
  background: #fff;
  box-shadow: 0 8rpx 28rpx rgba(15, 23, 42, .12);
}
