.page {
  min-height: 100vh;
  padding: 16rpx 24rpx calc(24rpx + env(safe-area-inset-bottom));
  box-sizing: border-box;
  background: #f6f8fa;
  display: flex;
  flex-direction: column;
}

.preview-state {
  min-height: 70vh;
  display: flex;
  flex-direction: column;
  align-items: center;
  justify-content: center;
  padding: 48rpx 44rpx;
  border: 1rpx solid var(--ui-border);
  border-radius: 24rpx;
  background: var(--ui-surface);
  box-sizing: border-box;
  text-align: center;
}

.state-title {
  margin-top: 26rpx;
  color: var(--ui-foreground);
  font-size: 30rpx;
  font-weight: 600;
}

.state-copy {
  max-width: 480rpx;
  margin-top: 12rpx;
  color: var(--ui-text-muted);
  font-size: 23rpx;
  line-height: 1.7;
}

.state-action {
  width: 340rpx;
  margin-top: 16rpx;
}

.state-action.ui-primary-button {
  margin-top: 32rpx;
}

.spinner {
  width: 40rpx;
  height: 40rpx;
  border: 3rpx solid var(--ui-border);
  border-top-color: var(--ui-accent);
  border-radius: 50%;
  animation: spin 0.8s linear infinite;
}

@keyframes spin {
  to { transform: rotate(360deg); }
}

@media (prefers-reduced-motion: reduce) {
  .spinner { animation: none; }
}

.preview-document {
  flex: 1;
  display: flex;
  flex-direction: column;
  align-items: center;
  width: 100%;
}

/* 顶部操作工具条 */
.preview-toolbar {
  width: 100%;
  display: flex;
  align-items: center;
  justify-content: space-between;
  margin-bottom: 14rpx;
  padding: 0 4rpx;
  box-sizing: border-box;
}

.toolbar-hint {
  display: flex;
  align-items: center;
  gap: 8rpx;
}

.hint-icon {
  font-size: 22rpx;
}

.hint-txt {
  font-size: 22rpx;
  color: #64748b;
  font-weight: 500;
}

.toolbar-controls {
  display: flex;
  align-items: center;
  gap: 12rpx;
}

.tool-btn {
  height: 52rpx;
  min-width: 52rpx;
  padding: 0 16rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  border-radius: 14rpx;
  background: #ffffff;
  border: 1rpx solid rgba(15, 23, 42, 0.08);
  box-shadow: 0 2rpx 8rpx rgba(15, 23, 42, 0.04);
  box-sizing: border-box;
  touch-action: manipulation;
  transition: all 0.15s ease;
}

.tool-btn-hover {
  background: #f1f5f9;
  transform: scale(0.95);
}

.tool-btn-symbol {
  font-size: 28rpx;
  font-weight: 600;
  color: #0f172a;
  line-height: 1;
}

.tool-btn-txt {
  font-size: 20rpx;
  font-weight: 600;
  color: #475569;
  line-height: 1;
}

/* 专用图片可交互视口区域 */
.preview-viewport {
  width: 100%;
  height: calc(100vh - 160rpx - env(safe-area-inset-bottom));
  overflow: hidden;
  border-radius: 28rpx;
  background: #e2e8f0;
  border: 1rpx solid rgba(15, 23, 42, 0.06);
  position: relative;
  box-sizing: border-box;
}

.preview-movable-sheet {
  width: 100%;
  height: 100%;
  display: flex;
  align-items: flex-start;
  justify-content: center;
  box-sizing: border-box;
  padding: 12rpx;
}

.preview-paper {
  width: 100%;
  overflow: hidden;
  border-radius: 20rpx;
  background: #ffffff;
  border: 1rpx solid rgba(15, 23, 42, 0.06);
  box-shadow: 0 10rpx 32rpx -6rpx rgba(15, 23, 42, 0.12), 0 2rpx 8rpx rgba(15, 23, 42, 0.04);
}

.resume-preview-image {
  display: block;
  width: 100%;
}

.preview-footnote {
  margin-top: 14rpx;
  color: #94a3b8;
  font-size: 20rpx;
  letter-spacing: 0.2rpx;
}
