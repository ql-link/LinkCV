.page {
  min-height: 100vh;
  padding: 24rpx 32rpx calc(48rpx + env(safe-area-inset-bottom));
  box-sizing: border-box;
  background: var(--ui-background);
}

.preview-state {
  min-height: 70vh;
  display: flex;
  flex-direction: column;
  align-items: center;
  justify-content: center;
  padding: 48rpx 44rpx;
  border: 1rpx solid var(--ui-border);
  border-radius: 24rpx;
  background: var(--ui-surface);
  box-sizing: border-box;
  text-align: center;
}

.state-title {
  margin-top: 26rpx;
  color: var(--ui-foreground);
  font-size: 30rpx;
  font-weight: 600;
}

.state-copy {
  max-width: 480rpx;
  margin-top: 12rpx;
  color: var(--ui-text-muted);
  font-size: 23rpx;
  line-height: 1.7;
}

.state-action {
  width: 340rpx;
  margin-top: 16rpx;
}

.state-action.ui-primary-button {
  margin-top: 32rpx;
}

.spinner {
  width: 40rpx;
  height: 40rpx;
  border: 3rpx solid var(--ui-border);
  border-top-color: var(--ui-accent);
  border-radius: 50%;
  animation: spin 0.8s linear infinite;
}

@keyframes spin {
  to { transform: rotate(360deg); }
}

@media (prefers-reduced-motion: reduce) {
  .spinner { animation: none; }
}

.preview-document {
  display: flex;
  flex-direction: column;
  align-items: center;
}

.preview-paper {
  width: 100%;
  overflow: hidden;
  border: 1rpx solid var(--ui-border);
  border-radius: 16rpx;
  background: var(--ui-surface);
  box-shadow: var(--ui-shadow-md);
}

.resume-preview-image {
  display: block;
  width: 100%;
}

.preview-footnote {
  margin-top: 24rpx;
  color: var(--ui-text-subtle);
  font-size: 20rpx;
}
