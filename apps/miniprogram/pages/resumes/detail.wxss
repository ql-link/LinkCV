page { background: #eef1f5; color: #1d1d1f; font-family: -apple-system, BlinkMacSystemFont, "SF Pro Text", "PingFang SC", sans-serif; }
.page { min-height: 100vh; padding: 24rpx 24rpx calc(52rpx + env(safe-area-inset-bottom)); box-sizing: border-box; }
.content { width: 100%; }
.readonly-strip { display: flex; align-items: center; padding: 0 14rpx 22rpx; color: #66717f; font-size: 21rpx; }
.status-dot { width: 10rpx; height: 10rpx; margin-right: 10rpx; border-radius: 50%; background: #267a4d; }
.strip-note { margin-left: auto; color: #8a929e; }

.document { padding: 52rpx 38rpx 46rpx; border: 1rpx solid #e0e4e9; border-radius: 22rpx; background: #fff; box-shadow: 0 18rpx 54rpx rgba(20, 32, 54, .075); box-sizing: border-box; }
.header { display: flex; flex-direction: column; padding-bottom: 38rpx; border-bottom: 2rpx solid #2c2c2e; }
.document-label { color: #636366; font-size: 18rpx; font-weight: 700; letter-spacing: 4rpx; }
.name { margin-top: 18rpx; font-size: 48rpx; font-weight: 650; letter-spacing: -2rpx; line-height: 1.2; }
.headline { margin-top: 10rpx; color: #3f4752; font-size: 27rpx; line-height: 1.5; }
.contacts { display: flex; margin-top: 20rpx; flex-wrap: wrap; gap: 12rpx; }
.contact { max-width: 100%; padding: 8rpx 14rpx; border-radius: 999rpx; background: #f1f4f8; color: #66717f; font-size: 21rpx; line-height: 1.35; word-break: break-all; }
.summary { margin-top: 24rpx; color: #3f4752; font-size: 25rpx; line-height: 1.75; white-space: pre-wrap; }

.section { margin-top: 42rpx; }
.section-heading { display: flex; align-items: center; margin-bottom: 4rpx; }
.section-rule { width: 26rpx; height: 5rpx; margin-right: 12rpx; border-radius: 5rpx; background: #1d1d1f; }
.section-title { color: #1d1d1f; font-size: 26rpx; font-weight: 700; letter-spacing: 1rpx; }
.entry { padding: 25rpx 0; border-bottom: 1rpx solid #eaedf1; }
.entry:last-child { border-bottom: 0; }
.entry-heading { display: flex; align-items: baseline; justify-content: space-between; gap: 20rpx; }
.entry-title { min-width: 0; flex: 1; color: #1d1d1f; font-size: 28rpx; font-weight: 600; line-height: 1.45; }
.entry-meta { flex-shrink: 0; color: #8a929e; font-size: 20rpx; line-height: 1.45; }
.entry-subtitle { display: block; margin-top: 7rpx; color: #586271; font-size: 23rpx; line-height: 1.5; }
.entry-content, .highlight { display: block; margin-top: 14rpx; color: #3f4752; font-size: 24rpx; line-height: 1.78; white-space: pre-wrap; }
.highlight { position: relative; margin-top: 9rpx; }
.document-end { display: flex; align-items: center; margin-top: 32rpx; color: #a0a7b1; font-size: 18rpx; letter-spacing: 2rpx; }
.document-end view { flex: 1; height: 1rpx; background: #e5e8ec; }
.document-end text { margin: 0 16rpx; }

.loading-document { min-height: 680rpx; display: flex; flex-direction: column; padding: 56rpx 40rpx; border-radius: 22rpx; background: #fff; box-sizing: border-box; }
.loading-head { width: 46%; height: 36rpx; margin-bottom: 34rpx; border-radius: 12rpx; background: #e4e8ed; }
.loading-line { width: 62%; height: 14rpx; margin-top: 18rpx; border-radius: 10rpx; background: #edf0f3; }
.loading-line-wide { width: 88%; }
.loading-section { width: 30%; height: 20rpx; margin-top: 74rpx; border-radius: 10rpx; background: #d7d7da; }
.loading-document text { margin-top: auto; color: #7b8592; font-size: 22rpx; text-align: center; }

.state-card { min-height: 560rpx; display: flex; flex-direction: column; align-items: center; justify-content: center; padding: 48rpx; border-radius: 24rpx; background: #fff; text-align: center; }
.state-icon { width: 76rpx; height: 76rpx; display: flex; align-items: center; justify-content: center; border-radius: 50%; background: #fff0f0; color: #c43b3b; font-size: 34rpx; font-weight: 700; }
.state-title { margin-top: 28rpx; font-size: 30rpx; font-weight: 600; }
.state-copy { margin-top: 14rpx; color: #66717f; font-size: 24rpx; line-height: 1.6; }
.secondary { min-width: 210rpx; height: 78rpx; margin-top: 30rpx; padding: 0 28rpx; border: 2rpx solid #d2d2d7; border-radius: 20rpx; background: #fff; color: #3f4752; font-size: 25rpx; font-weight: 600; line-height: 78rpx; touch-action: manipulation; }
.secondary::after { border: 0; }
.secondary-pressed { border-color: #1d1d1f; background: #fafafc; }
