<view class="preview-state" wx:if="{{loading}}">
  <view class="spinner"></view>
  <text class="state-kicker">LOADING</text>
  <text class="state-title">{{progress > 0 ? '正在下载简历 ' + progress + '%' : '正在准备简历…'}}</text>
  <text class="state-copy">首次打开会保存到本机，同一版本下次可直接查看</text>
</view>
<view class="preview-state" wx:elif="{{error}}">
  <text class="state-kicker state-kicker-error">ERROR</text>
  <text class="state-title">无法打开这份简历</text>
  <text class="state-copy">{{error}}</text>
  <button class="btn-primary state-action" hover-class="btn-primary-pressed" bindtap="retryLoad">重新加载</button>
  <button class="btn-ghost state-action" hover-class="btn-ghost-pressed" bindtap="backToResumes">返回简历列表</button>
</view>
<view class="preview-document" wx:else>
  <view class="preview-paper">
    <image class="resume-preview-image" src="{{previewPath}}" mode="widthFix" binderror="handlePreviewError" />
  </view>
  <text class="preview-footnote">只读预览 · 编辑请前往 LinkCV 网页端</text>
</view>
