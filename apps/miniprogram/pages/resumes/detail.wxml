<view class="preview-state" wx:if="{{loading}}">
  <view class="spinner"></view>
  <text class="state-title">{{progress > 0 ? '正在下载简历 ' + progress + '%' : '正在准备简历…'}}</text>
  <text class="state-copy">首次打开会保存到本机，同一版本下次可直接查看</text>
</view>
<view class="preview-state" wx:elif="{{error}}">
  <text class="state-title">无法打开这份简历</text>
  <text class="state-copy">{{error}}</text>
  <button class="ui-primary-button state-action" hover-class="ui-primary-button-pressed" bindtap="retryLoad">重新加载</button>
  <button class="ui-secondary-button state-action" hover-class="ui-secondary-button-pressed" bindtap="backToResumes">返回简历列表</button>
</view>
<view class="preview-document" wx:else>
  <!-- 顶部缩放查阅提示胶囊 -->
  <view class="preview-tip-pill" bindtap="handleImagePreview">
    <text class="tip-icon">🔍</text>
    <text class="tip-text">点击图片可全屏双指放大、拖动查阅</text>
  </view>

  <!-- 简历纸张展示区 -->
  <view class="preview-paper" hover-class="preview-paper-pressed" bindtap="handleImagePreview">
    <image
      class="resume-preview-image"
      src="{{previewPath}}"
      mode="widthFix"
      show-menu-by-longpress="{{true}}"
      binderror="handlePreviewError"
    />
  </view>
  <text class="preview-footnote">只读预览 · 编辑请前往 LinkResume 网页端</text>
</view>
