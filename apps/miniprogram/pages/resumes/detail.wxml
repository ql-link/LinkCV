<view class="preview-state" wx:if="{{loading}}">
  <view class="spinner"></view>
  <text class="state-title">{{progress > 0 ? '正在下载简历 ' + progress + '%' : '正在准备简历…'}}</text>
  <text class="state-copy">首次打开会保存到本机，同一版本下次可直接查看</text>
</view>
<view class="preview-state" wx:elif="{{error}}">
  <text class="state-title">无法打开这份简历</text>
  <text class="state-copy">{{error}}</text>
  <button class="ui-primary-button state-action" hover-class="ui-primary-button-pressed" bindtap="retryLoad">重新加载</button>
  <button class="ui-secondary-button state-action" hover-class="ui-secondary-button-pressed" bindtap="backToResumes">返回简历列表</button>
</view>
<view class="preview-document" wx:else>
  <!-- 顶部缩放与操作工具条 -->
  <view class="preview-toolbar">
    <view class="toolbar-hint">
      <text class="hint-icon">🔍</text>
      <text class="hint-txt">区域内支持双指缩放与自由拖拽</text>
    </view>
    <view class="toolbar-controls">
      <view class="tool-btn" hover-class="tool-btn-hover" bindtap="zoomOut" role="button" aria-label="缩小">
        <text class="tool-btn-symbol">−</text>
      </view>
      <view class="tool-btn tool-btn-reset" hover-class="tool-btn-hover" bindtap="resetZoom" role="button" aria-label="还原">
        <text class="tool-btn-txt">100%</text>
      </view>
      <view class="tool-btn" hover-class="tool-btn-hover" bindtap="zoomIn" role="button" aria-label="放大">
        <text class="tool-btn-symbol">+</text>
      </view>
    </view>
  </view>

  <!-- 专门的图片展示与交互区域（直接在当前页面缩放、拖拽） -->
  <movable-area class="preview-viewport">
    <movable-view
      class="preview-movable-sheet"
      direction="all"
      scale="{{true}}"
      scale-min="1"
      scale-max="4"
      scale-value="{{scaleValue}}"
      inertia="{{true}}"
      out-of-bounds="{{true}}"
    >
      <view class="preview-paper">
        <image
          class="resume-preview-image"
          src="{{previewPath}}"
          mode="widthFix"
          show-menu-by-longpress="{{true}}"
          binderror="handlePreviewError"
        />
      </view>
    </movable-view>
  </movable-area>

  <text class="preview-footnote">只读查阅 · 编辑请前往 LinkResume 网页端</text>
</view>
