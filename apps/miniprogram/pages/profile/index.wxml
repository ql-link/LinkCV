<view class="page" style="padding-top: calc({{statusBarHeight}}px + 32rpx)">
  <view class="topbar">
    <view class="ui-brand">
      <image class="ui-brand-wordmark" src="/assets/linkresume-wordmark.png" mode="aspectFit" aria-label="LinkResume"></image>
    </view>
  </view>
  <view class="content">
    <text class="page-title">我的</text>
    <view class="context-note" wx:if="{{!guest}}">
      <text class="context-icon">▤</text>
      <text class="context-text">头像与昵称仅在小程序内展示，可随时修改</text>
    </view>

    <view class="loading-block" wx:if="{{loading && !guest}}">
      <view class="spinner"></view>
      <text class="loading-text">正在加载资料…</text>
    </view>

    <view class="guest-card" wx:elif="{{guest}}">
      <text class="guest-title">登录后管理你的资料</text>
      <text class="guest-copy">登录后可编辑头像和昵称，并查看与你账号关联的简历。</text>
      <button class="guest-action" hover-class="guest-action-pressed" bindtap="goLogin">微信登录</button>
    </view>

    <view wx:else>
      <view class="avatar-wrap">
        <button class="avatar-button" open-type="chooseAvatar" bindchooseavatar="handleChooseAvatar" hover-class="avatar-button-pressed" disabled="{{saving}}">
          <image class="avatar-image" wx:if="{{localAvatarPath}}" src="{{localAvatarPath}}" mode="aspectFill"></image>
          <view class="avatar-placeholder" wx:else>{{nickname ? nickname[0] : '客'}}</view>
        </button>
        <text class="avatar-hint">点击头像更换，可选微信头像或相册图片</text>
      </view>

      <view class="field-card">
        <text class="field-label">昵称</text>
        <view class="field-row">
          <input
            class="field-input"
            type="nickname"
            value="{{nickname}}"
            placeholder="点击输入，可一键使用微信昵称"
            placeholder-class="field-placeholder"
            bindinput="handleNicknameInput"
          />
        </view>
      </view>

      <text class="form-message" wx:if="{{message}}">{{message}}</text>

      <button class="save-button" hover-class="save-button-pressed" bindtap="handleSave" disabled="{{saving || loading}}">{{saving ? '正在保存…' : '保存修改'}}</button>
      <button class="logout-button" hover-class="logout-button-pressed" bindtap="handleLogout" disabled="{{saving || loggingOut}}">{{loggingOut ? '正在退出…' : '退出登录'}}</button>
    </view>
  </view>
</view>
