<view class="page" style="padding-top: calc({{statusBarHeight}}px + 32rpx)">
  <view class="topbar">
    <view class="ui-brand">
      <image class="ui-brand-mark" src="/assets/linkcv-mark.png" mode="aspectFit" aria-hidden="true"></image>
      <text>LinkCV</text>
    </view>
  </view>
  <view class="content">
    <text class="page-title">资料设置</text>

    <view class="loading-block" wx:if="{{loading}}">
      <view class="spinner"></view>
      <text class="loading-text">正在加载资料…</text>
    </view>

    <view wx:else>
      <view class="group">
        <button class="row avatar-row" open-type="chooseAvatar" bindchooseavatar="handleChooseAvatar" hover-class="row-pressed" disabled="{{saving}}">
          <text class="row-label">头像</text>
          <view class="row-value">
            <image class="avatar" wx:if="{{localAvatarPath}}" src="{{localAvatarPath}}" mode="aspectFill"></image>
            <view class="avatar avatar-placeholder" wx:else>{{nickname ? nickname[0] : '客'}}</view>
            <text class="chevron">›</text>
          </view>
        </button>
        <view class="divider"></view>
        <view class="row">
          <text class="row-label">昵称</text>
          <input
            class="nickname-input"
            type="nickname"
            value="{{nickname}}"
            placeholder="点击输入"
            placeholder-class="nickname-placeholder"
            bindinput="handleNicknameInput"
          />
        </view>
      </view>

      <text class="hint">点击头像可使用微信头像或从相册选择；输入昵称时键盘上方可一键使用微信昵称</text>
      <text class="form-message" wx:if="{{message}}">{{message}}</text>

      <button class="save-button" hover-class="save-button-pressed" bindtap="handleSave" disabled="{{saving || loading}}">{{saving ? '正在保存…' : '保存修改'}}</button>
    </view>
  </view>
  <view class="privacy-note">头像与昵称仅用于在小程序内展示，可随时修改</view>
</view>
