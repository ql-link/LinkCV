<view class="page" style="padding-top: calc({{statusBarHeight}}px + 32rpx)">
  <view class="topbar">
    <view class="ui-brand">
      <image class="ui-brand-mark" src="/assets/linkcv-mark.png" mode="aspectFit" aria-hidden="true"></image>
      <text>LinkCV</text>
    </view>
  </view>
  <view class="content">
    <text class="page-title">资料设置</text>
    <view class="context-note">
      <text class="context-icon">▤</text>
      <text class="context-text">头像与昵称仅在小程序内展示，可随时修改</text>
    </view>

    <view class="loading-block" wx:if="{{loading}}">
      <view class="spinner"></view>
      <text class="loading-text">正在加载资料…</text>
    </view>

    <view wx:else>
      <view class="avatar-wrap">
        <button class="avatar-button" open-type="chooseAvatar" bindchooseavatar="handleChooseAvatar" hover-class="avatar-button-pressed" disabled="{{saving}}">
          <image class="avatar-image" wx:if="{{localAvatarPath}}" src="{{localAvatarPath}}" mode="aspectFill"></image>
          <view class="avatar-placeholder" wx:else>{{nickname ? nickname[0] : '客'}}</view>
        </button>
        <text class="avatar-hint">点击头像更换，可选微信头像或相册图片</text>
      </view>

      <view class="field-card">
        <text class="field-label">昵称</text>
        <view class="field-row">
          <input
            class="field-input"
            type="nickname"
            value="{{nickname}}"
            placeholder="点击输入，可一键使用微信昵称"
            placeholder-class="field-placeholder"
            bindinput="handleNicknameInput"
          />
        </view>
      </view>

      <text class="form-message" wx:if="{{message}}">{{message}}</text>

      <button class="save-button" hover-class="save-button-pressed" bindtap="handleSave" disabled="{{saving || loading}}">{{saving ? '正在保存…' : '保存修改'}}</button>
    </view>
  </view>
</view>
