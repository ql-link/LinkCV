.page { min-height: 100vh; display: flex; flex-direction: column; padding: 0 32rpx calc(32rpx + env(safe-area-inset-bottom)); box-sizing: border-box; overflow-x: hidden; }
.topbar { min-height: 88rpx; display: flex; align-items: center; }
.content { flex: 1; display: flex; flex-direction: column; width: 100%; max-width: 680rpx; margin: 0 auto; padding: 24rpx 8rpx 60rpx; box-sizing: border-box; }
.title { color: var(--ui-foreground); font-size: 54rpx; font-weight: 700; letter-spacing: -2rpx; line-height: 1.2; }

.context-note { display: flex; align-items: center; margin-top: 28rpx; padding: 18rpx 22rpx; border: 1rpx solid var(--ui-border); border-radius: 16rpx; background: var(--ui-surface); }
.context-icon { width: 44rpx; height: 44rpx; flex-shrink: 0; display: flex; align-items: center; justify-content: center; border-radius: 11rpx; background: var(--ui-accent-subtle); color: var(--ui-accent); font-size: 23rpx; }
.context-text { min-width: 0; flex: 1; margin-left: 16rpx; color: var(--ui-text-secondary); font-size: 23rpx; line-height: 1.5; }

.loading-block { display: flex; flex-direction: column; align-items: center; padding: 120rpx 0; }
.loading-text { margin-top: 20rpx; color: var(--ui-text-muted); font-size: 22rpx; }

.spinner { width: 40rpx; height: 40rpx; border: 3rpx solid var(--ui-border); border-top-color: var(--ui-accent); border-radius: 50%; animation: spin 0.8s linear infinite; }
@keyframes spin { to { transform: rotate(360deg); } }
@media (prefers-reduced-motion: reduce) { .spinner { animation: none; } }

.avatar-row { display: flex; justify-content: center; margin-top: 56rpx; }
.avatar-button { position: relative; width: 168rpx; height: 168rpx; margin: 0; padding: 0; border-radius: 50%; background: transparent; line-height: 1; overflow: hidden; }
.avatar-button::after { border: 0; }
.avatar-button-pressed { opacity: 0.85; }
.avatar-image { width: 168rpx; height: 168rpx; border-radius: 50%; display: block; }
.avatar-placeholder { width: 168rpx; height: 168rpx; display: flex; align-items: center; justify-content: center; border-radius: 50%; background: var(--ui-surface-muted); color: var(--ui-text-secondary); font-size: 56rpx; font-weight: 600; }
.avatar-edit { position: absolute; right: 0; bottom: 0; left: 0; padding: 8rpx 0; background: rgba(23, 25, 28, 0.55); color: #fff; font-size: 19rpx; text-align: center; }

.field { display: flex; flex-direction: column; margin-top: 48rpx; padding: 24rpx; border: 1rpx solid var(--ui-border); border-radius: 16rpx; background: var(--ui-surface); }
.field-label { color: var(--ui-text-muted); font-size: 21rpx; }
.field-input { margin-top: 12rpx; color: var(--ui-foreground); font-size: 28rpx; min-height: 48rpx; }

.form-message { display: block; margin-top: 18rpx; color: var(--ui-warning); font-size: 22rpx; }

.save-button { width: 100%; height: 88rpx; display: flex; align-items: center; justify-content: center; margin: 36rpx 0 0; padding: 0 30rpx; border-radius: 16rpx; background: var(--ui-accent); color: #fff; font-size: 27rpx; font-weight: 600; line-height: 88rpx; box-sizing: border-box; touch-action: manipulation; }
.save-button::after { border: 0; }
.save-button-pressed { background: var(--ui-accent-hover); }
.save-button[disabled] { opacity: 0.5; }

.privacy-note { padding: 0 32rpx calc(24rpx + env(safe-area-inset-bottom)); color: var(--ui-text-subtle); font-size: 20rpx; line-height: 1.5; text-align: center; }
