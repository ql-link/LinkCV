.page {
  min-height: 100vh;
  display: flex;
  flex-direction: column;
  padding: 0 36rpx calc(48rpx + env(safe-area-inset-bottom));
  box-sizing: border-box;
  overflow-x: hidden;
  background: #ffffff;
  position: relative;
}

/* 顶部轻柔氛围光晕 */
.header-ambient-glow {
  position: absolute;
  top: 0;
  left: 0;
  right: 0;
  height: 360rpx;
  background: linear-gradient(180deg, rgba(241, 245, 249, 0.7) 0%, rgba(248, 250, 252, 0.3) 60%, transparent 100%);
  pointer-events: none;
}

.topbar {
  min-height: 88rpx;
  display: flex;
  align-items: center;
  position: relative;
  z-index: 2;
}

.content {
  flex: 1;
  display: flex;
  flex-direction: column;
  width: 100%;
  max-width: 680rpx;
  margin: 0 auto;
  padding: 16rpx 0 40rpx;
  box-sizing: border-box;
  position: relative;
  z-index: 2;
}

/* 用户头部：自然通透，无卡片框 */
.user-profile-header {
  display: flex;
  align-items: center;
  padding: 24rpx 4rpx 44rpx;
  box-sizing: border-box;
}

.avatar-box {
  position: relative;
  width: 132rpx;
  height: 132rpx;
  flex-shrink: 0;
}

.avatar-round, .user-avatar-button {
  width: 132rpx;
  height: 132rpx;
  margin: 0;
  padding: 0;
  border-radius: 50%;
  background: transparent;
  line-height: 1;
  overflow: visible;
  position: relative;
}
.user-avatar-button::after { border: 0; }
.avatar-hover { opacity: 0.88; transform: scale(0.97); transition: transform 0.15s ease; }

.avatar-img {
  width: 132rpx;
  height: 132rpx;
  border-radius: 50%;
  display: block;
}

.avatar-text {
  width: 132rpx;
  height: 132rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  border-radius: 50%;
  background: #0f172a;
  color: #ffffff;
  font-size: 50rpx;
  font-weight: 600;
}

.guest-avatar {
  display: flex;
  flex-direction: column;
  align-items: center;
  border-radius: 50%;
  background: #e2e8f0;
  overflow: hidden;
  position: relative;
}
.avatar-silhouette-head {
  width: 38rpx;
  height: 38rpx;
  border-radius: 50%;
  background: #94a3b8;
  margin-top: 26rpx;
}
.avatar-silhouette-body {
  width: 80rpx;
  height: 56rpx;
  border-radius: 40rpx 40rpx 0 0;
  background: #94a3b8;
  margin-top: 8rpx;
}

.avatar-edit-tag {
  position: absolute;
  right: -2rpx;
  bottom: -2rpx;
  width: 42rpx;
  height: 42rpx;
  border-radius: 50%;
  background: #0f172a;
  color: #ffffff;
  font-size: 20rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  border: 4rpx solid #ffffff;
  box-sizing: border-box;
}

.profile-info {
  flex: 1;
  min-width: 0;
  margin-left: 28rpx;
  display: flex;
  flex-direction: column;
  justify-content: center;
}

.name-line {
  display: flex;
  align-items: center;
  flex-wrap: wrap;
  gap: 12rpx;
}

.user-name {
  color: #0f172a;
  font-size: 38rpx;
  font-weight: 700;
  letter-spacing: -0.5rpx;
  line-height: 1.3;
}

.status-pill {
  display: inline-flex;
  align-items: center;
  gap: 6rpx;
  padding: 4rpx 14rpx;
  border-radius: 20rpx;
  font-size: 20rpx;
  font-weight: 500;
}
.status-pill.is-guest {
  background: #f1f5f9;
  color: #64748b;
}
.status-pill.is-active {
  background: #ecfdf5;
  color: #047857;
}
.status-dot {
  width: 8rpx;
  height: 8rpx;
  border-radius: 50%;
  background: currentColor;
}

.hint-line {
  margin-top: 10rpx;
}

.hint-text {
  color: #64748b;
  font-size: 24rpx;
  line-height: 1.4;
}

/* 主体区域 */
.profile-body {
  display: flex;
  flex-direction: column;
}

/* 无方框感的高级扁平列表 */
.settings-list {
  padding: 0 4rpx;
  margin-top: 12rpx;
}

.setting-row {
  display: flex;
  align-items: center;
  justify-content: space-between;
  min-height: 96rpx;
  padding: 8rpx 0;
}

.setting-label {
  color: #1e293b;
  font-size: 28rpx;
  font-weight: 500;
}

.setting-action {
  display: flex;
  align-items: center;
  gap: 8rpx;
}
.setting-action.is-input {
  flex: 1;
  margin-left: 28rpx;
  justify-content: flex-end;
}

.nickname-input {
  width: 100%;
  text-align: right;
  color: #0f172a;
  font-size: 28rpx;
  font-weight: 500;
}

.input-placeholder {
  color: #94a3b8;
  font-size: 26rpx;
}

.placeholder-text {
  color: #94a3b8;
  font-size: 26rpx;
}

.status-val {
  font-size: 27rpx;
  font-weight: 500;
}
.status-val.is-muted { color: #94a3b8; }
.status-val.is-success { color: #047857; }

.arrow-icon {
  color: #94a3b8;
  font-size: 30rpx;
  font-weight: 400;
}

.setting-divider {
  height: 1rpx;
  background: #f1f5f9;
  width: 100%;
}

/* 提示信息 */
.form-message {
  display: block;
  margin-top: 24rpx;
  padding: 0 10rpx;
  color: #dc2626;
  font-size: 24rpx;
  text-align: center;
}

/* 底部按钮组 */
.btn-group {
  display: flex;
  flex-direction: column;
  gap: 20rpx;
  margin-top: 80rpx;
  padding: 0 4rpx;
}

.btn-primary {
  width: 100%;
  height: 92rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  margin: 0;
  padding: 0;
  border-radius: 20rpx;
  background: #0f172a;
  color: #ffffff;
  font-size: 28rpx;
  font-weight: 600;
  letter-spacing: 0.5rpx;
  box-shadow: 0 6rpx 18rpx -2rpx rgba(15, 23, 42, 0.18);
  box-sizing: border-box;
  touch-action: manipulation;
}
.btn-primary::after { border: 0; }
.btn-primary-hover { background: #1e293b; opacity: 0.92; transform: scale(0.99); }
.btn-primary[disabled] { opacity: 0.5; box-shadow: none; }

.btn-secondary {
  width: 100%;
  height: 88rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  margin: 0;
  padding: 0;
  border: 1rpx solid #e2e8f0;
  border-radius: 20rpx;
  background: #ffffff;
  color: #475569;
  font-size: 27rpx;
  font-weight: 500;
  box-sizing: border-box;
  touch-action: manipulation;
}
.btn-secondary::after { border: 0; }
.btn-secondary-hover { background: #f8fafc; color: #0f172a; }
.btn-secondary[disabled] { opacity: 0.5; }

/* 加载动画 */
.loading-block {
  display: flex;
  flex-direction: column;
  align-items: center;
  padding: 120rpx 0;
}
.loading-text {
  margin-top: 24rpx;
  color: #94a3b8;
  font-size: 24rpx;
}
.spinner {
  width: 44rpx;
  height: 44rpx;
  border: 4rpx solid #e2e8f0;
  border-top-color: #0f172a;
  border-radius: 50%;
  animation: spin 0.8s linear infinite;
}
@keyframes spin { to { transform: rotate(360deg); } }
@media (prefers-reduced-motion: reduce) { .spinner { animation: none; } }
