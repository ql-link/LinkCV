.page { min-height: 100vh; display: flex; flex-direction: column; padding: 0 32rpx calc(40rpx + env(safe-area-inset-bottom)); box-sizing: border-box; overflow-x: hidden; }
.topbar { min-height: 88rpx; display: flex; align-items: center; }
.content { flex: 1; display: flex; flex-direction: column; width: 100%; max-width: 680rpx; margin: 0 auto; padding: 20rpx 8rpx 60rpx; box-sizing: border-box; }

.page-title { color: var(--ui-foreground); font-size: 44rpx; font-weight: 700; letter-spacing: -1rpx; line-height: 1.3; }

.context-note { display: flex; align-items: center; margin-top: 24rpx; padding: 18rpx 22rpx; border: 1rpx solid var(--ui-border); border-radius: 16rpx; background: var(--ui-surface); }
.context-icon { width: 44rpx; height: 44rpx; flex-shrink: 0; display: flex; align-items: center; justify-content: center; border-radius: 11rpx; background: var(--ui-accent-subtle); color: var(--ui-accent); font-size: 23rpx; }
.context-text { min-width: 0; flex: 1; margin-left: 16rpx; color: var(--ui-text-secondary); font-size: 23rpx; line-height: 1.5; }

.avatar-wrap { display: flex; flex-direction: column; align-items: center; margin-top: 48rpx; }
.avatar-button { position: relative; width: 160rpx; height: 160rpx; margin: 0; padding: 0; border-radius: 50%; background: transparent; line-height: 1; overflow: visible; }
.avatar-button::after { border: 0; }
.avatar-button-pressed { opacity: 0.85; }
.avatar-image { width: 160rpx; height: 160rpx; border-radius: 50%; display: block; }
.avatar-placeholder { width: 160rpx; height: 160rpx; display: flex; align-items: center; justify-content: center; border-radius: 50%; background: var(--ui-surface-muted); color: var(--ui-text-secondary); font-size: 56rpx; font-weight: 600; }

.avatar-camera { position: absolute; right: -6rpx; bottom: -6rpx; width: 52rpx; height: 52rpx; display: flex; flex-direction: column; align-items: center; justify-content: center; gap: 3rpx; border: 4rpx solid var(--ui-surface); border-radius: 50%; background: var(--ui-accent); box-sizing: content-box; }
.camera-body { width: 24rpx; height: 16rpx; border: 3rpx solid #fff; border-radius: 4rpx; box-sizing: border-box; }
.camera-head { width: 10rpx; height: 5rpx; border-radius: 2rpx 2rpx 0 0; background: #fff; }

.avatar-hint { margin-top: 20rpx; color: var(--ui-text-subtle); font-size: 21rpx; }

.field-card { display: flex; flex-direction: column; margin-top: 44rpx; padding: 26rpx 28rpx 28rpx; border: 1rpx solid var(--ui-border); border-radius: 18rpx; background: var(--ui-surface); }
.field-label { color: var(--ui-text-muted); font-size: 22rpx; }
.field-row { display: flex; align-items: center; margin-top: 14rpx; border-bottom: 2rpx solid var(--ui-border); }
.field-input { flex: 1; min-height: 56rpx; color: var(--ui-foreground); font-size: 29rpx; }
.field-placeholder { color: var(--ui-text-subtle); font-size: 25rpx; }

.form-message { display: block; margin-top: 18rpx; padding: 0 8rpx; color: var(--ui-warning); font-size: 22rpx; }

.save-button { width: 100%; height: 88rpx; display: flex; align-items: center; justify-content: center; margin: 40rpx 0 0; padding: 0 30rpx; border-radius: 16rpx; background: var(--ui-accent); color: #fff; font-size: 27rpx; font-weight: 600; line-height: 88rpx; box-sizing: border-box; touch-action: manipulation; }
.save-button::after { border: 0; }
.save-button-pressed { background: var(--ui-accent-hover); }
.save-button[disabled] { opacity: 0.5; }

.loading-block { display: flex; flex-direction: column; align-items: center; padding: 120rpx 0; }
.loading-text { margin-top: 20rpx; color: var(--ui-text-muted); font-size: 22rpx; }
.spinner { width: 40rpx; height: 40rpx; border: 3rpx solid var(--ui-border); border-top-color: var(--ui-accent); border-radius: 50%; animation: spin 0.8s linear infinite; }
@keyframes spin { to { transform: rotate(360deg); } }
@media (prefers-reduced-motion: reduce) { .spinner { animation: none; } }
