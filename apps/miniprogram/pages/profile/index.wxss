.page { min-height: 100vh; display: flex; flex-direction: column; padding: 0 32rpx calc(32rpx + env(safe-area-inset-bottom)); box-sizing: border-box; overflow-x: hidden; }
.topbar { min-height: 88rpx; display: flex; align-items: center; }
.content { flex: 1; display: flex; flex-direction: column; width: 100%; max-width: 680rpx; margin: 0 auto; padding: 20rpx 8rpx 60rpx; box-sizing: border-box; }

.page-title { color: var(--ui-foreground); font-size: 40rpx; font-weight: 700; letter-spacing: -1rpx; line-height: 1.3; }

.group { margin-top: 32rpx; border: 1rpx solid var(--ui-border); border-radius: 18rpx; background: var(--ui-surface); overflow: hidden; }

.row { display: flex; align-items: center; min-height: 108rpx; padding: 16rpx 26rpx; background: var(--ui-surface); box-sizing: border-box; }
.avatar-row { width: 100%; margin: 0; border-radius: 0; font-size: inherit; line-height: inherit; text-align: inherit; }
.avatar-row::after { border: 0; }
.row-pressed { background: var(--ui-surface-subtle); }

.row-label { width: 140rpx; flex-shrink: 0; color: var(--ui-foreground); font-size: 27rpx; font-weight: 500; }

.row-value { min-width: 0; flex: 1; display: flex; align-items: center; justify-content: flex-end; gap: 12rpx; }

.avatar { width: 88rpx; height: 88rpx; border-radius: 50%; display: flex; align-items: center; justify-content: center; }
.avatar-placeholder { background: var(--ui-surface-muted); color: var(--ui-text-secondary); font-size: 36rpx; font-weight: 600; }

.chevron { color: var(--ui-text-subtle); font-size: 38rpx; line-height: 1; }

.divider { height: 1rpx; margin: 0 26rpx; background: var(--ui-border); }

.nickname-input { min-width: 0; flex: 1; color: var(--ui-foreground); font-size: 27rpx; text-align: right; }
.nickname-placeholder { color: var(--ui-text-subtle); font-size: 25rpx; }

.hint { display: block; margin-top: 18rpx; padding: 0 8rpx; color: var(--ui-text-subtle); font-size: 20rpx; line-height: 1.6; }

.form-message { display: block; margin-top: 16rpx; padding: 0 8rpx; color: var(--ui-warning); font-size: 22rpx; }

.save-button { width: 100%; height: 88rpx; display: flex; align-items: center; justify-content: center; margin: 40rpx 0 0; padding: 0 30rpx; border-radius: 16rpx; background: var(--ui-accent); color: #fff; font-size: 27rpx; font-weight: 600; line-height: 88rpx; box-sizing: border-box; touch-action: manipulation; }
.save-button::after { border: 0; }
.save-button-pressed { background: var(--ui-accent-hover); }
.save-button[disabled] { opacity: 0.5; }

.loading-block { display: flex; flex-direction: column; align-items: center; padding: 120rpx 0; }
.loading-text { margin-top: 20rpx; color: var(--ui-text-muted); font-size: 22rpx; }
.spinner { width: 40rpx; height: 40rpx; border: 3rpx solid var(--ui-border); border-top-color: var(--ui-accent); border-radius: 50%; animation: spin 0.8s linear infinite; }
@keyframes spin { to { transform: rotate(360deg); } }
@media (prefers-reduced-motion: reduce) { .spinner { animation: none; } }

.privacy-note { padding: 0 32rpx calc(24rpx + env(safe-area-inset-bottom)); color: var(--ui-text-subtle); font-size: 20rpx; line-height: 1.5; text-align: center; }
