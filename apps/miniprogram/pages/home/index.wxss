.page {
  min-height: 100vh;
  padding: 0 32rpx calc(40rpx + env(safe-area-inset-bottom));
  box-sizing: border-box;
}

.topbar {
  height: 116rpx;
  display: flex;
  align-items: center;
  justify-content: space-between;
}

.topbar-tag {
  color: var(--ui-text-muted);
  font-size: 22rpx;
}

.page-head {
  display: flex;
  flex-direction: column;
  padding: 10rpx 8rpx 34rpx;
}

.page-title {
  color: var(--ui-foreground);
  font-size: 44rpx;
  font-weight: 650;
  letter-spacing: -1rpx;
  line-height: 1.3;
}

.page-subtitle {
  margin-top: 12rpx;
  color: var(--ui-text-muted);
  font-size: 25rpx;
  line-height: 1.6;
}

.head-action {
  margin-top: 32rpx;
}

.head-hint {
  margin-top: 16rpx;
  color: var(--ui-text-subtle);
  font-size: 20rpx;
}

.sample-card {
  display: flex;
  flex-direction: column;
  overflow: hidden;
  border: 1rpx solid var(--ui-border);
  border-radius: 24rpx;
  background: var(--ui-surface);
}

.sample-preview {
  display: flex;
  align-items: center;
  justify-content: center;
  padding: 34rpx 0 30rpx;
  border-bottom: 1rpx solid var(--ui-border);
  background: var(--ui-surface-subtle);
}

.sample-document {
  width: 200rpx;
  padding: 22rpx 20rpx;
  border: 1rpx solid var(--ui-border-strong);
  border-radius: 8rpx;
  background: var(--ui-surface);
  box-shadow: var(--ui-shadow-sm);
}

.doc-title {
  width: 48%;
  height: 12rpx;
  margin-bottom: 14rpx;
  border-radius: 999rpx;
  background: var(--ui-foreground);
}

.doc-line {
  height: 7rpx;
  margin-top: 12rpx;
  border-radius: 999rpx;
  background: var(--ui-border-strong);
}

.doc-line.is-short {
  width: 66%;
}

.doc-heading {
  width: 34%;
  height: 8rpx;
  margin-top: 24rpx;
  border-radius: 999rpx;
  background: var(--ui-text-secondary);
}

.sample-meta {
  display: flex;
  flex-direction: column;
  padding: 22rpx 24rpx 24rpx;
  background: var(--ui-surface);
}

.sample-name {
  overflow: hidden;
  color: var(--ui-foreground);
  font-size: 28rpx;
  font-weight: 600;
  text-overflow: ellipsis;
  white-space: nowrap;
}

.sample-time {
  margin-top: 6rpx;
  color: var(--ui-text-muted);
  font-size: 22rpx;
}

.sample-actions {
  margin-top: 20rpx;
}

.sample-open {
  display: flex;
  width: 100%;
  height: 76rpx;
  align-items: center;
  justify-content: center;
  margin: 0;
  padding: 0 24rpx;
  border: 1rpx solid var(--ui-accent);
  border-radius: 14rpx;
  background: var(--ui-accent);
  color: var(--ui-primary-foreground);
  font-size: 24rpx;
  font-weight: 600;
  line-height: 76rpx;
  box-sizing: border-box;
  touch-action: manipulation;
}

.sample-open::after {
  border: 0;
}

.sample-open-pressed {
  background: var(--ui-accent-hover);
}

.sample-hint {
  margin-top: 16rpx;
  color: var(--ui-text-subtle);
  font-size: 20rpx;
}

.feature-card {
  margin-top: 34rpx;
  border: 1rpx solid var(--ui-border);
  border-radius: 24rpx;
  background: var(--ui-surface);
}

.feature-row {
  display: flex;
  padding: 26rpx 24rpx;
  border-bottom: 1rpx solid var(--ui-border);
}

.feature-row.is-last {
  border-bottom: 0;
}

.feature-copy {
  display: flex;
  flex-direction: column;
}

.feature-title {
  color: var(--ui-foreground);
  font-size: 27rpx;
  font-weight: 600;
}

.feature-desc {
  margin-top: 8rpx;
  color: var(--ui-text-muted);
  font-size: 22rpx;
  line-height: 1.6;
}

.page-footnote {
  margin-top: 36rpx;
  color: var(--ui-text-subtle);
  font-size: 20rpx;
  line-height: 1.5;
  text-align: center;
}
