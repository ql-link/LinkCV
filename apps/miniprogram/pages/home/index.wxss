.page {
  min-height: 100vh;
  display: flex;
  flex-direction: column;
  padding: 0 56rpx calc(40rpx + env(safe-area-inset-bottom));
  box-sizing: border-box;
}

.brand-row {
  height: 116rpx;
  display: flex;
  align-items: center;
}

.hero {
  display: flex;
  flex-direction: column;
  align-items: center;
  margin-top: 40rpx;
  text-align: center;
}

.hero-title {
  color: var(--ui-foreground);
  font-size: 56rpx;
  font-weight: 700;
  letter-spacing: -2rpx;
  line-height: 1.35;
}

.hero-sub {
  margin-top: 16rpx;
  color: var(--ui-text-muted);
  font-size: 25rpx;
  line-height: 1.6;
}

.hero-cta {
  width: 100%;
  max-width: 520rpx;
  height: 92rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  margin: 44rpx 0 0;
  padding: 0 32rpx;
  border-radius: 18rpx;
  background: var(--ui-primary);
  color: var(--ui-primary-foreground);
  font-size: 28rpx;
  font-weight: 600;
  line-height: 92rpx;
  box-sizing: border-box;
  touch-action: manipulation;
}

.hero-cta::after {
  border: 0;
}

.hero-cta-pressed {
  background: var(--ui-primary-hover);
}

.hero-hint {
  margin-top: 16rpx;
  color: var(--ui-text-subtle);
  font-size: 21rpx;
}

.sample {
  display: flex;
  flex-direction: column;
  align-items: center;
  margin-top: 64rpx;
}

.sample-paper {
  width: 260rpx;
  padding: 30rpx 26rpx;
  border: 2rpx solid var(--ui-border);
  border-radius: 12rpx;
  background: var(--ui-surface);
}

.s-head {
  width: 44%;
  height: 14rpx;
  margin-bottom: 20rpx;
  border-radius: 6rpx;
  background: var(--ui-foreground);
}

.s-line {
  height: 8rpx;
  margin-top: 16rpx;
  border-radius: 6rpx;
  background: var(--ui-border);
}

.s-line.is-short {
  width: 62%;
}

.sample-hint {
  margin-top: 18rpx;
  color: var(--ui-text-subtle);
  font-size: 20rpx;
}

.points {
  display: flex;
  justify-content: center;
  gap: 64rpx;
  margin-top: 72rpx;
}

.point {
  display: flex;
  flex-direction: column;
  align-items: center;
  gap: 10rpx;
}

.point-icon {
  width: 64rpx;
  height: 64rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  border-radius: 18rpx;
  background: var(--ui-surface);
  border: 1rpx solid var(--ui-border);
  color: var(--ui-text-secondary);
  font-size: 28rpx;
}

.point-label {
  color: var(--ui-text-muted);
  font-size: 20rpx;
}

.footnote {
  margin-top: auto;
  padding-top: 48rpx;
  color: var(--ui-text-subtle);
  font-size: 19rpx;
  line-height: 1.5;
  text-align: center;
}
