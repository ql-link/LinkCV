<view class="canvas">
  <view class="canvas-grid"></view>
  <view class="topbar">
    <view class="brand">
      <view class="brand-mark">L</view>
      <view class="brand-copy">
        <text class="brand-name">LinkCV</text>
        <text class="brand-sub">随 身 简 历 册</text>
      </view>
    </view>
  </view>
  <view class="content">
    <view class="hero">
      <text class="kicker">RESUME READER</text>
      <text class="hero-title">你的简历，
随时翻阅。</text>
      <text class="hero-sub">在网页端创建和管理简历，打开小程序即可随身查看，求职路上不再手忙脚乱。</text>
      <view class="hero-actions">
        <button class="btn-primary" hover-class="btn-primary-pressed" bindtap="handlePrimaryAction">{{loggedIn ? '查看我的简历' : '微信登录查看简历'}} →</button>
        <text class="hero-note">登录前可自由浏览本页内容</text>
      </view>
    </view>

    <view class="sample">
      <view class="sample-head">
        <text class="sample-label">示例简历</text>
        <text class="sample-label-sub">SPECIMEN</text>
      </view>
      <view class="sample-card">
        <view class="sample-card-inner">
          <view class="sample-header">
            <view class="sample-header-copy">
              <text class="sample-name">张三</text>
              <text class="sample-role">FRONTEND ENGINEER</text>
            </view>
            <view class="sample-mark">L</view>
          </view>
          <view class="sample-contact">
            <text>BEIJING</text>
            <text>LINKCV.EXAMPLE</text>
          </view>
          <view class="sample-section">
            <view class="sample-section-title"><text>EXPERIENCE</text><view class="sample-rule"></view></view>
            <view class="sample-line sample-line-strong"></view>
            <view class="sample-line"></view>
            <view class="sample-line sample-line-short"></view>
          </view>
          <view class="sample-section">
            <view class="sample-section-title"><text>SKILLS</text><view class="sample-rule"></view></view>
            <view class="sample-line"></view>
            <view class="sample-line sample-line-short"></view>
          </view>
          <view class="sample-footer">
            <text>BUILT WITH LINKCV</text>
            <text>LINKRESUME.CN</text>
          </view>
        </view>
      </view>
      <text class="sample-hint">示例内容 · 登录后这里会展示你的真实简历</text>
    </view>

    <view class="features">
      <view class="feature-row">
        <view class="feature-cell">
          <text class="feature-kicker">CREATE</text>
          <text class="feature-title">网页端编辑</text>
        </view>
        <text class="feature-copy">多套模板与实时预览，在电脑上完成简历创作</text>
      </view>
      <view class="feature-row">
        <view class="feature-cell">
          <text class="feature-kicker">CARRY</text>
          <text class="feature-title">小程序随身查看</text>
        </view>
        <text class="feature-copy">面试前快速翻阅自己的简历内容，随时心中有数</text>
      </view>
      <view class="feature-row">
        <view class="feature-cell">
          <text class="feature-kicker">SECURE</text>
          <text class="feature-title">扫码安全登录网页</text>
        </view>
        <text class="feature-copy">在网页端扫码并于小程序确认，无需记忆额外密码</text>
      </view>
    </view>
  </view>
  <view class="footnote">简历数据仅在登录后加载 · 微信身份只用于登录</view>
</view>
