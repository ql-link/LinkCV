<view class="page" style="padding-top: {{statusBarHeight}}px">
  <view class="brand-row">
    <view class="ui-brand">
      <image class="ui-brand-mark" src="/assets/linkcv-mark.png" mode="aspectFit" aria-hidden="true"></image>
      <text>LinkCV</text>
    </view>
  </view>

  <view class="hero">
    <text class="hero-title">你的简历
随身翻阅</text>
    <text class="hero-sub">在网页端创建简历，面试路上随时翻阅。</text>
  </view>

  <view class="sample">
    <view class="sample-stack" aria-hidden="true">
      <view class="sample-paper is-back"></view>
      <view class="sample-paper">
        <view class="rs-head">
          <text class="rs-name">张三</text>
          <text class="rs-role">前端工程师 · 北京</text>
          <text class="rs-contact">zhangsan@example.com · 138-0000-0000</text>
        </view>
        <view class="rs-section">
          <text class="rs-section-title">工作经历</text>
          <view class="rs-entry">
            <view class="rs-entry-row">
              <text class="rs-entry-title">星云科技 · 高级前端工程师</text>
              <text class="rs-time">2023 – 至今</text>
            </view>
            <text class="rs-entry-desc">负责在线简历编辑器与协同排版引擎</text>
          </view>
          <view class="rs-entry">
            <view class="rs-entry-row">
              <text class="rs-entry-title">远山信息 · 前端工程师</text>
              <text class="rs-time">2021 – 2023</text>
            </view>
            <text class="rs-entry-desc">搭建组件库与数据可视化模块</text>
          </view>
        </view>
        <view class="rs-section">
          <text class="rs-section-title">教育背景</text>
          <view class="rs-entry-row">
            <text class="rs-entry-title">临江大学 · 计算机科学与技术</text>
            <text class="rs-time">2017 – 2021</text>
          </view>
        </view>
        <view class="rs-section">
          <text class="rs-section-title">技能</text>
          <text class="rs-skills">TypeScript / React / Node.js / 富文本排版</text>
        </view>
      </view>
    </view>
    <text class="sample-hint">示例内容为虚构信息 · 登录后展示你的简历</text>
  </view>

  <view class="cta-area">
    <button class="hero-cta" hover-class="hero-cta-pressed" bindtap="handlePrimaryAction">{{loggedIn ? '查看我的简历' : '微信登录查看简历'}}</button>
    <text class="hero-hint">登录前可自由浏览本页</text>
  </view>

  <view class="points">
    <view class="point">
      <text class="point-icon">✎</text>
      <text class="point-label">网页端编辑</text>
    </view>
    <view class="point">
      <text class="point-icon">▤</text>
      <text class="point-label">随身查看</text>
    </view>
    <view class="point">
      <text class="point-icon">⌘</text>
      <text class="point-label">扫码登录网页</text>
    </view>
  </view>

  <view class="footnote">简历数据仅在登录后加载 · 微信身份只用于登录</view>
</view>
