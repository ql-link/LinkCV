.page {
  min-height: 100vh;
  display: flex;
  flex-direction: column;
  padding-right: 48rpx;
  padding-bottom: calc(40rpx + env(safe-area-inset-bottom));
  padding-left: 48rpx;
  box-sizing: border-box;
  overflow-x: hidden;
  background: var(--ui-surface);
}
.topbar { position: relative; width: 100%; min-height: 88rpx; }
.close-button { position: absolute; top: 8rpx; left: -16rpx; z-index: 2; width: 72rpx; height: 72rpx; display: flex; align-items: center; justify-content: center; border-radius: 50%; background: transparent; line-height: 1; }
.close-button::after, .secondary-button::after { border: 0; }
.close-button-pressed { background: var(--ui-surface-muted); }
.content { min-height: 0; flex: 1; display: flex; flex-direction: column; align-items: center; width: 100%; max-width: 654rpx; margin: 0 auto; }
.identity { display: flex; flex-direction: column; align-items: center; width: 100%; margin-top: min(22vh, 280rpx); text-align: center; }
.brand-card { width: 320rpx; height: 72rpx; display: flex; align-items: center; justify-content: center; }
.brand-mark { width: 320rpx; height: 66rpx; display: block; }
.title { margin-top: 46rpx; color: var(--ui-foreground); font-size: 52rpx; font-weight: 700; letter-spacing: -2rpx; line-height: 1.2; }
.subtitle { display: block; max-width: 590rpx; margin-top: 14rpx; color: #50627c; font-size: 25rpx; line-height: 1.55; word-break: break-word; }
.inline-status { height: 28rpx; display: flex; align-items: center; justify-content: center; margin-top: 18rpx; }
.spinner { width: 22rpx; height: 22rpx; border: 3rpx solid var(--ui-border); border-top-color: var(--ui-foreground); border-radius: 50%; animation: spin .8s linear infinite; }
@keyframes spin { to { transform: rotate(360deg); } }
.actions { width: 100%; margin-top: 102rpx; }
.confirm-primary-button { width: 100%; height: 108rpx; border-radius: 22rpx; background: #000; color: #fff; font-size: 29rpx; font-weight: 600; line-height: 108rpx; }
.confirm-primary-button-pressed { background: #232323; transform: translateY(1rpx); }
.secondary-button { height: 76rpx; margin: 18rpx auto 0; padding: 0 28rpx; background: transparent; color: var(--ui-text-secondary); font-size: 25rpx; line-height: 76rpx; }
.secondary-button-bordered { width: 100%; height: 88rpx; margin-top: 0; border: 2rpx solid var(--ui-border-strong); border-radius: 18rpx; line-height: 88rpx; }
.secondary-button-pressed { color: var(--ui-foreground); background: var(--ui-surface-muted); }
.consent { width: 100%; margin-top: auto; padding-top: 72rpx; padding-bottom: 18rpx; box-sizing: border-box; }
.agreement-row { display: flex; align-items: center; justify-content: center; }
.agreement-checkbox { flex-shrink: 0; margin-right: 4rpx; transform: scale(.76); transform-origin: center; }
.agreement-copy { color: #526079; font-size: 22rpx; line-height: 1.55; }
.agreement-link { color: var(--ui-accent); font-weight: 600; }
.agreement-hint { display: block; margin-top: 10rpx; color: var(--ui-warning); font-size: 21rpx; line-height: 1.5; text-align: center; }
@media (max-height: 700px) { .identity { margin-top: 80rpx; } .actions { margin-top: 64rpx; } .consent { padding-top: 48rpx; } }
@media (prefers-reduced-motion: reduce) { .spinner { animation: none; } .confirm-primary-button-pressed { transform: none; } }
