@import "../../styles/shared.wxss";

.topbar-tag {
  color: var(--ink-faint);
  font-family: var(--font-mono);
  font-size: 18rpx;
  letter-spacing: 6rpx;
}

.content {
  position: relative;
  z-index: 1;
  flex: 1;
  display: flex;
  flex-direction: column;
  justify-content: center;
  padding: 40rpx 0;
}

.canvas {
  display: flex;
  flex-direction: column;
}

.head {
  display: flex;
  flex-direction: column;
  align-items: center;
  text-align: center;
}

.head-title {
  margin-top: 24rpx;
  font-size: 56rpx;
}

.status-card {
  display: flex;
  align-items: center;
  margin-top: 44rpx;
  padding: 26rpx 28rpx;
  box-sizing: border-box;
}

.status-confirmed {
  border-color: rgba(38, 122, 77, 0.3);
}

.status-expired,
.status-error {
  border-color: rgba(196, 59, 59, 0.28);
}

.status-indicator {
  width: 44rpx;
  height: 44rpx;
  flex-shrink: 0;
  display: flex;
  align-items: center;
  justify-content: center;
  border-radius: 50%;
  border: 1rpx solid var(--hairline);
  color: var(--ink);
  font-size: 26rpx;
  font-weight: 700;
}

.status-confirmed .status-indicator {
  border-color: #267a4d;
  background: #267a4d;
  color: #fff;
}

.status-expired .status-indicator,
.status-error .status-indicator {
  border-color: #c43b3b;
  background: #c43b3b;
  color: #fff;
}

.status-message {
  min-width: 0;
  flex: 1;
  margin-left: 20rpx;
  color: var(--ink-soft);
  font-size: 24rpx;
  line-height: 1.6;
  word-break: break-all;
}

.consent {
  margin-top: 30rpx;
  padding: 24rpx 26rpx;
  border: 1rpx solid var(--hairline);
  border-radius: 4rpx;
  background: rgba(255, 255, 255, 0.66);
  box-sizing: border-box;
}

.agreement-row {
  display: flex;
  align-items: flex-start;
}

.agreement-checkbox {
  flex-shrink: 0;
  transform: scale(0.82);
  transform-origin: left top;
}

.agreement-copy {
  min-width: 0;
  flex: 1;
  color: var(--ink-soft);
  font-size: 23rpx;
  line-height: 1.6;
}

.agreement-link {
  color: var(--accent);
  font-weight: 600;
}

.agreement-hint {
  display: block;
  margin-top: 10rpx;
  padding-left: 48rpx;
  color: var(--accent);
  font-family: var(--font-mono);
  font-size: 19rpx;
}

.spinner {
  width: 24rpx;
  height: 24rpx;
  border: 3rpx solid rgba(24, 24, 27, 0.14);
  border-top-color: var(--ink);
  border-radius: 50%;
  animation: spin 0.8s linear infinite;
}

@keyframes spin {
  to { transform: rotate(360deg); }
}

.actions {
  margin-top: 36rpx;
}

.actions .btn-ghost,
.actions .btn-primary + .btn-primary {
  margin-top: 16rpx;
}

@media (prefers-reduced-motion: reduce) {
  .spinner { animation: none; }
}
