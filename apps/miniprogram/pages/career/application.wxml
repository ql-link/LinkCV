<page-meta
  page-style="{{sessionId || scheduleSheetOpen ? 'overflow:hidden' : ''}}"
/>
<brand-navigation title="求职详情" back fallback="/pages/career/index" />
<view class="career-page detail-page">
  <view class="detail-loading" wx:if="{{loading && !app}}" role="status"><view class="loading-spinner" /><text>正在加载求职详情…</text></view>
  <view wx:if="{{error}}" class="error"
    >{{error}}<button class="secondary" bindtap="load">重新加载</button></view
  >
  <block wx:if="{{app}}">
    <view class="detail-hero"
      ><view class="row spread"
        ><text class="company-title grow">{{app.company_name_snapshot}}</text
        ><button class="advance" wx:if="{{app.canAdvance}}" disabled="{{loading}}" bindtap="stage">
          <text class="advance-plus" aria-hidden="true">+</text><text>{{app.canSchedule ? '添加安排' : '推进流程'}}</text>
        </button></view
      ><view class="row"
        ><text class="subtitle">{{app.job_title_snapshot}}</text
        ><text class="employment">{{app.employmentLabel}}</text></view
      ></view
    >
    <view class="panel progress-panel"
      ><text class="heading">求职进度</text
      ><scroll-view
        scroll-x
        class="progress-scroll"
        scroll-into-view="progress-{{progress[progress.length - 1].id}}"
        ><view class="progress-track"
          ><view
            wx:for="{{progress}}"
            wx:key="id"
            id="progress-{{item.id}}"
            class="progress-step {{item.state}}"
            ><view
              class="progress-connector"
              wx:if="{{index < progress.length - 1}}"
            /><view class="progress-dot"
              ><image
                wx:if="{{item.done}}"
                class="progress-check"
                src="/assets/career/progress-check.svg" /><image wx:elif="{{item.state === 'offer'}}" class="progress-crown" src="/assets/career/progress-crown.svg" /><text wx:elif="{{item.state === 'ended'}}">!</text></view
            ><text class="progress-label">{{item.label}}</text
            ><text class="hint">{{item.date}}</text></view
          ></view
        ></scroll-view
      ><text class="hint"
        >{{app.phase === 'pending' ? '尚未记录投递信息' : app.appliedLabel + ' 投递'}}</text
      ></view
    >
    <view class="panel records-panel"
      ><text class="heading">面试记录</text><text class="hint" wx:if="{{loading}}">正在加载面试记录…</text
      ><view
        class="session-card"
        wx:for="{{sessions}}"
        wx:key="id"
        data-id="{{item.id}}"
        bindtap="openSession"
        role="button"
        ><view class="row spread"
          ><text class="session-name grow">{{item.stage_label}}</text
          ><view class="status-badge tone-{{item.tone}}"
            ><career-icon
              name="{{item.icon}}"
              tone="{{item.tone}}"
              size="30"
            /><text>{{item.statusLabel}}</text></view
          ></view
        ><text class="hint">{{item.shortTimeLabel}} · {{item.modeLabel}}</text
        ><text class="detail-link">查看面试详情</text></view
      ><text class="hint" wx:if="{{!loading && !sessions.length}}"
        >当前暂无面试安排。</text
      ></view
    >
    <view class="panel" wx:if="{{app.tone === 'offer'}}"
      ><text class="heading">Offer 信息</text
      ><text class="subtitle"
        >{{app.offer_base_location || '未填写工作地点'}}</text
      ><text class="hint"
        >{{app.offer_salary ? app.offer_salary + ' ' + app.offer_salary_currency + ' / ' + app.offerPeriodLabel : '未填写薪资'}}</text
      ><text class="hint"
        >{{app.offer_benefits_description || '未填写福利待遇'}}</text
      ><button class="link" data-mode="offer" bindtap="openForm">
        编辑 Offer 信息
      </button></view
    >
    <view class="panel job-summary"
      ><text class="heading">岗位信息</text
      ><text class="subtitle"
        >{{job.city}}{{job.salary ? (job.city ? ' · ' : '') + job.salary : ''}}{{job.employment ? (job.city || job.salary ? ' · ' : '') + job.employment : ''}}</text
      ><text class="job-excerpt"
        >{{job.description || '岗位描述暂未记录。'}}</text
      ><view class="resources"
        ><button data-kind="job" bindtap="openMaterial">
          <career-icon name="briefcase" size="30" />查看完整岗位</button
        ><button
          wx:if="{{app.resume_version_id}}"
          data-kind="resume"
          bindtap="openMaterial"
        >
          <career-icon name="file" size="30" />查看关联简历
        </button></view
      ></view
    >
  </block></view
>
<career-tabs selected="{{1}}" hidden="{{!!sessionId || scheduleSheetOpen}}" />
<session-sheet
  wx:if="{{sessionId}}"
  session-id="{{sessionId}}"
  bind:close="closeSession"
  bind:changed="load"
/>
<schedule-sheet
  wx:if="{{scheduleSheetOpen}}"
  application-id="{{id}}"
  bind:close="closeSchedule"
  bind:saved="closeSchedule"
/>
