@import "./shared.wxss";
.detail-page {
  padding-bottom: calc(78px + env(safe-area-inset-bottom));
}
.detail-hero {
  display: flex;
  flex-direction: column;
  gap: 8px;
  padding: 4px 0 6px;
  margin-bottom: 12px;
}
.company-title {
  font-size: 22px;
  line-height: 30px;
  font-weight: 700;
}
.detail-page .advance {
  display: flex;
  align-items: center;
  justify-content: center;
  gap: 4px;
  width: auto;
  height: 32px;
  padding: 0 10px;
  border-radius: 8px;
  background: #17191c;
  color: #fff;
  font-size: 13px;
  line-height: 20px;
  font-weight: 400;
  flex-shrink: 0;
  white-space: nowrap;
}
.advance-plus {
  font-family: -apple-system, sans-serif;
  font-size: 18px;
  line-height: 20px;
}
.employment {
  padding: 3px 8px;
  border-radius: 6px;
  background: #edf1f5;
  font-size: 11px;
  line-height: 16px;
  color: #3f4752;
}
.detail-page .panel {
  padding: 14px 16px;
  margin-bottom: 12px;
  display: flex;
  flex-direction: column;
  gap: 14px;
}
.detail-page .heading {
  font-size: 17px;
  line-height: 25px;
}
.progress-track {
  display: flex;
  min-width: 100%;
  padding: 0 0 2px;
}
.progress-step {
  position: relative;
  flex: 1;
  min-width: 96px;
  display: flex;
  flex-direction: column;
  gap: 8px;
  align-items: center;
  text-align: center;
  font-size: 12px;
  line-height: 18px;
}
.progress-dot {
  width: 24px;
  height: 24px;
  box-sizing: border-box;
  border: 3px solid #145ed6;
  border-radius: 50%;
  background: #fff;
  display: flex;
  align-items: center;
  justify-content: center;
  z-index: 1;
}
.done .progress-dot {
  background: #267a4d;
  border-color: #267a4d;
}
.progress-connector {
  position: absolute;
  top: 11px;
  height: 2px;
  background: #c3ccd6;
  left: 50%;
  width: 100%;
}
.progress-label {
  color: #3f4752;
}
.current .progress-label {
  color: #145ed6;
}
.progress-step .hint {
  font-size: 11px;
  white-space: nowrap;
}
.session-card {
  background: #f9fafb;
  border-radius: 10px;
  padding: 12px;
  display: flex;
  flex-direction: column;
  gap: 8px;
}
.session-name {
  font-size: 15px;
  line-height: 22px;
}
.status-badge {
  display: flex;
  align-items: center;
  gap: 6px;
  padding: 3px 8px;
  border-radius: 6px;
  font-size: 12px;
  line-height: 17px;
  white-space: nowrap;
  background: #edf1f5;
}
.status-badge.tone-accent {
  background: #e9f1fd;
}
.status-badge.tone-success {
  background: #eaf7f0;
}
.status-badge.tone-warning {
  background: #fff6e8;
}
.detail-link {
  color: #145ed6;
  font-size: 12px;
  line-height: 18px;
}
.job-summary .subtitle {
  font-size: 13px;
  line-height: 20px;
  white-space: nowrap;
  overflow: hidden;
  text-overflow: ellipsis;
}
.job-excerpt {
  font-size: 12px;
  line-height: 19px;
  color: #3f4752;
  display: -webkit-box;
  -webkit-line-clamp: 2;
  -webkit-box-orient: vertical;
  overflow: hidden;
}
.resources {
  display: flex;
  gap: 10px;
}
.detail-page .resources button {
  flex: 1;
  width: 0;
  display: flex;
  align-items: center;
  justify-content: center;
  gap: 6px;
  padding: 10px 8px;
  border-radius: 9px;
  background: #f9fafb;
  font-size: 12px;
  white-space: nowrap;
}

.progress-check {
  width: 24px;
  height: 24px;
}
.done .progress-dot { border: 0; }

.detail-loading { min-height:240px; display:flex; flex-direction:column; align-items:center; justify-content:center; gap:14px; color:#6f7a8c; font-size:14px; }
.loading-spinner { width:24px; height:24px; border:2px solid #dbe0e8; border-top-color:#145ed6; border-radius:50%; animation:detail-loading-spin .8s linear infinite; }
@keyframes detail-loading-spin { to { transform:rotate(360deg); } }
.advance[disabled] { opacity:.5; }
@media(prefers-reduced-motion:reduce) { .loading-spinner { animation:none; } }

.offer .progress-dot {border-color:#d5a514;background:#d5a514;color:#fff;}
.offer .progress-label {color:#9a6a00;}
.progress-crown {width:18px;height:18px;}
.ended .progress-dot {border-color:#c43b3b;background:#c43b3b;color:#fff;font-weight:700;}
.ended .progress-label {color:#c43b3b;}
.cancelled .progress-dot,.pending .progress-dot {border-color:#c3ccd6;background:#edf1f5;}
.cancelled .progress-label,.pending .progress-label {color:#6f7a8c;}
