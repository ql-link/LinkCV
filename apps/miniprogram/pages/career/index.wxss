@import "./shared.wxss";
/* Figma 27:136: 20px page inset, 16px panel inset, 80 × 28px primary action. */
.career-home {
  height: 100vh;
  overflow: hidden;
  display: flex;
  flex-direction: column;
  box-sizing: border-box;
  font-family:
    "LinkResume Career UI",
    -apple-system,
    "PingFang SC",
    sans-serif;
  padding-bottom: calc(54px + env(safe-area-inset-bottom));
}
.career-scroll {
  flex: 1;
  height: 0;
  min-height: 0;
  width: 100%;
}
.home-header {
  flex-shrink: 0;
  position: relative;
  z-index: 20;
  background: #f4f6f8;
}
.navigation {
  height: 64px;
  padding: 4px 24px 8px;
  display: flex;
  align-items: center;
  gap: 4px;
  box-sizing: border-box;
}
.nav-item {
  position: relative;
  display: flex;
  align-items: center;
  justify-content: center;
  gap: 8px;
  flex: 1;
  height: 44px;
  padding-bottom: 7px;
  box-sizing: border-box;
  color: #6f7a8c;
  font-size: 16px;
  white-space: nowrap;
  transition: color 160ms ease;
}
.nav-item.active {
  color: #145ed6;
  font-size: 20px;
  font-weight: 600;
}
.underline {
  position: absolute;
  width: 24px;
  height: 3px;
  background: #145ed6;
  bottom: 0;
  border-radius: 1.5px;
  /* 指示线由 wx:if 挂载，每次选中都会重新播放这段入场。 */
  animation: career-underline-in 200ms ease-out;
}
.career-page {
  padding-top: 8px;
}
/* 两个 tab 共用同一套外层内边距（Figma 的 8,20,12,20）。底部安全区由 .career-home
   统一预留，这里不再重复叠加。两个类各自挂不同的入场动画名——类名一换，动画名跟着换，
   切换 tab 时动画才会重新播放；用同一个动画名则不会重启。 */
.applications-body {
  box-sizing: border-box;
  padding: 8px 20px 12px;
  animation: career-tab-in-from-right 240ms cubic-bezier(.22, 1, .36, 1);
}
.schedule-body {
  display: flex;
  flex-direction: column;
  box-sizing: border-box;
  padding: 8px 20px 12px;
  animation: career-tab-in-from-left 240ms cubic-bezier(.22, 1, .36, 1);
}
/* 未登录的整页提示不再套白色卡片：沿用简历页 .state-card 的写法——居中、无底色、
   无边框圆角，直接在页面底色上排版。页面按 scroll-view 可视区铺满（`.career-page`
   那条 min-height 是按时间表算的，比可视区矮，整页提示不能沿用），这样游客停在
   面试安排还是求职记录，提示都落在真正的中线上。 */
.guest-body {
  display: flex;
  flex-direction: column;
  min-height: 100%;
}
.state-card {
  flex: 1;
  display: flex;
  flex-direction: column;
  align-items: center;
  justify-content: center;
  padding: 24px 20px;
  box-sizing: border-box;
  background: transparent;
  text-align: center;
}
.state-card .primary {
  margin-top: 16px;
}
.schedule-panel {
  flex: 1;
  display: flex;
  flex-direction: column;
  /* 日期挂窗的定位参照。 */
  position: relative;
  margin: 0;
  /* 圆角跟随 shared.wxss 的 .panel（14px），内边距与求职记录卡统一为 14px：
     两边都按 350 宽带 14px 内陷排版，内层内容宽度都是 322，切 tab 时不会有横向错步。 */
  padding: 14px;
}
.schedule-toolbar {
  flex-shrink: 0;
  gap: 12px;
  height: 28px;
}
.date-stepper {
  display: flex;
  align-items: center;
  gap: 4px;
  min-width: 0;
}
/* 两侧箭头各走一天，点日期本身打开月历挂窗。箭头在这里比原来的日历图标更能说明
   「可以前后翻」，日期本身也不再是一个看不出可点的纯文字。 */
.date-arrow {
  display: flex;
  align-items: center;
  justify-content: center;
  flex: 0 0 28px;
  width: 28px;
  height: 28px;
  border-radius: 6px;
  color: #3f4752;
  /* 单角引号本身比字号小一圈，20px 时太细，压不住 17px 的日期。 */
  font-size: 24px;
  line-height: 1;
}
.date-arrow-pressed {
  background: #edf1f5;
}
.date-control {
  display: flex;
  align-items: center;
  justify-content: center;
  /* 日期位数变化时两侧箭头不跟着抖。 */
  min-width: 118px;
  min-height: 28px;
  color: #17191c;
  font-size: 17px;
  font-weight: 600;
  white-space: nowrap;
  border-radius: 6px;
}
.date-control-pressed {
  background: #edf1f5;
}
/* 挂窗贴着工具栏下沿挂在面板里，不铺遮罩，所以看起来是浮层而不是弹窗。 */
.date-popover {
  position: absolute;
  top: 50px;
  left: 14px;
  right: 14px;
  z-index: 30;
}
.schedule-toolbar .add-schedule {
  display: inline-flex;
  align-items: center;
  justify-content: center;
  flex: 0 0 80px;
  width: 80px;
  max-width: 80px;
  min-width: 0;
  height: 28px;
  min-height: 28px;
  max-height: 28px;
  margin: 0 0 0 auto;
  padding: 0 8px;
  box-sizing: border-box;
  background: #17191c;
  color: #fff;
  font-size: 12px;
  font-weight: 600;
  line-height: 1.45;
  white-space: nowrap;
  border-radius: 6px;
}
.schedule-toolbar .add-schedule-pressed {
  background: #383c42;
}
.time-grid {
  position: relative;
  flex: 1;
  margin-top: 12px;
}
.hour {
  font-family:
    Inter,
    -apple-system,
    sans-serif;
  position: absolute;
  display: flex;
  align-items: center;
  width: 100%;
  transform: translateY(-50%);
  font-size: 10px;
  line-height: 1.45;
  color: #6f7a8c;
  font-variant-numeric: tabular-nums;
}
.hour-label {
  width: 50px;
  flex-shrink: 0;
}
.hour-line {
  flex: 1;
  height: 1px;
  background: rgba(219, 224, 232, 0.5);
}
.events {
  position: absolute;
  left: 50px;
  right: 0;
  top: 0;
  bottom: 0;
}
.event {
  position: absolute;
  display: flex;
  flex-direction: column;
  /* 每小时 56px 的底数让块有余量：两行内容 46px，居中排比顶头排更稳，长块也不会头重脚轻。 */
  justify-content: center;
  gap: 2px;
  background: #e9f1fd;
  color: #145ed6;
  border: 0;
  border-radius: 8px;
  padding: 4px 8px;
  box-sizing: border-box;
  overflow: hidden;
  /* 只留右侧的假缝：并排时用来分隔两栏。加在底部会在单栏时把块底削掉 2px。 */
  box-shadow: inset -2px 0 #fff;
}
/* 超过两小时的块改顶对齐，见 career.js 的 TIMELINE_CENTER_MAX_MINUTES。 */
.event.event-top {
  justify-content: flex-start;
}
.event.tone-success {
  background: #eaf7f0;
  color: #267a4d;
}
.event.tone-warning {
  background: #fff6e8;
  color: #9a5b13;
}
.event.tone-neutral {
  background: #edf1f5;
  color: #6f7a8c;
}
.event-title {
  display: flex;
  align-items: center;
  gap: 6px;
  min-width: 0;
  /* 两行都不许收缩：块偏矮时 flex 会把行高压下去，文字看起来是被压扁而不是被裁掉。 */
  flex-shrink: 0;
}
.event-company {
  display: block;
  /* 窄块优先保住公司名：自己不收缩，但最多占 68%，留出阶段的位置。 */
  flex-shrink: 0;
  max-width: 68%;
  min-width: 0;
  font-size: 13px;
  font-weight: 600;
  line-height: 1.45;
  color: #17191c;
  white-space: nowrap;
  overflow: hidden;
  text-overflow: ellipsis;
}
.event-stage {
  display: block;
  min-width: 0;
  flex-shrink: 1;
  font-size: 12px;
  line-height: 1.45;
  color: inherit;
  white-space: nowrap;
  overflow: hidden;
  text-overflow: ellipsis;
}
.event-time {
  display: block;
  min-width: 0;
  flex-shrink: 0;
  font-size: 12px;
  line-height: 1.45;
  color: #6f7a8c;
  font-variant-numeric: tabular-nums;
  white-space: nowrap;
  overflow: hidden;
  text-overflow: ellipsis;
}
.conflict-hint {
  position: absolute;
  left: 0;
  right: 0;
  font-size: 11px;
  line-height: 16px;
  color: #9a5b13;
}
.schedule-empty {
  position: absolute;
  top: 42%;
  left: 50px;
  right: 0;
  text-align: center;
  color: #6f7a8c;
  font-size: 13px;
  background: rgba(255, 255, 255, 0.92);
  padding: 9px 0;
}
.filters {
  white-space: nowrap;
  margin: 22rpx 0;
  width: 100%;
}
.filter {
  display: inline-block;
  padding: 14rpx 24rpx;
  border-radius: 12rpx;
  font-size: 25rpx;
  color: #6f7a8c;
}
.search career-icon {
  display: inline-flex;
  flex-shrink: 0;
}
.filters {
  margin: 20rpx 0 24rpx;
}
.filter {
  padding: 4rpx 0;
  margin-right: 30rpx;
  font-size: 24rpx;
  border-radius: 0;
}
.filter.selected {
  background: transparent;
  color: var(--ui-foreground);
  font-weight: 600;
}
.application-card {
  padding: 32rpx;
  border-radius: 31rpx;
}
.application-card .title {
  font-size: 35rpx;
}
.application-card .subtitle {
  margin-top: 16rpx;
  color: var(--ui-text-secondary);
  font-size: 27rpx;
}
.employment {
  color: var(--ui-text-muted);
  font-size: 23rpx;
  margin-left: 16rpx;
  flex-shrink: 0;
}
.stage-name {
  font-size: 27rpx;
}
/* 徽标一律无底色：文字颜色由 shared.wxss 的 .tone-* 提供，图标另带 tone。
   两个右侧标签直接落在白卡上，文字与卡片内容右缘对齐，不再有胶囊底造成的错位。 */
.status-badge {
  display: flex;
  align-items: center;
  gap: 8rpx;
  font-size: 22rpx;
  white-space: nowrap;
}
.status-badge.tone-neutral {
  color: #566173;
}
.application-card .hint {
  margin-top: 16rpx;
  font-size: 23rpx;
}
/* Figma 27:2 — real data uses the same record-card geometry. */
.filters {
  margin: 12px 0;
  width: 100%;
}
.filter {
  padding: 0;
  margin-right: 16px;
  font-size: 13px;
  line-height: 19px;
}
.application-card {
  padding: 16px;
  border-radius: 14px;
  margin-bottom: 12px;
}
.application-card .title {
  font-size: 19px;
  font-weight: 700;
  line-height: 1.45;
}
.application-card .subtitle {
  margin-top: 8px;
  font-size: 14px;
  line-height: 1.45;
  color: #3f4752;
}
.employment {
  font-size: 12px;
  color: #6f7a8c;
  margin-left: 12px;
}
.stage-name {
  font-size: 14px;
  font-weight: 700;
  line-height: 1.45;
}
.status-badge {
  gap: 6px;
  font-size: 12px;
  line-height: 1.45;
}
.application-card .hint {
  margin-top: 8px;
  font-size: 12px;
  line-height: 1.45;
}
/* Confirmed Figma list: transparent filters and compact company / role cards. */
.filters {
  display: flex;
  gap: 6px;
  margin: 12px 0;
  white-space: normal;
}
.filter {
  flex: 1;
  min-width: 0;
  height: 40px;
  padding: 0;
  display: flex;
  flex-direction: column;
  align-items: center;
  justify-content: center;
  gap: 5px;
  font-size: 13px;
  line-height: 23px;
  border-radius: 0;
  background: transparent;
}
.filters .filter.selected {
  font-size: 16px;
  color: #145ed6;
  background: transparent;
  font-weight: 700;
}
.filter-line {
  width: 20px;
  height: 2px;
  background: transparent;
  border-radius: 2px;
}
.selected .filter-line {
  background: #145ed6;
}
.career-page .application-card {
  /* 与面试安排的面板统一为 14px，见 .schedule-panel 的说明。 */
  padding: 14px;
  display: flex;
  flex-direction: column;
  gap: 10px;
  margin-bottom: 12px;
}
.career-page .application-card .card-title {
  gap: 12px;
}
.card-identity {
  flex: 1;
  min-width: 0;
  font-size: 13px;
  line-height: 22px;
}
.company-name {
  font-size: 15px;
  font-weight: 700;
}
.job-name {
  font-size: 14px;
  font-weight: 600;
}
.application-card .employment {
  /* 招聘类型同样无底色，只用文字颜色区分实习 / 校招 / 正式。 */
  color: #566173;
  font-size: 11px;
  line-height: 16px;
  white-space: nowrap;
}
.application-card .employment-internship {
  color: #267a4d;
}
.application-card .employment-campus {
  color: #145ed6;
}
/* 卡片整体可点，按压反馈与同页的日期选择、添加安排保持一致。 */
.career-page .application-card-pressed {
  background: var(--ui-secondary-hover);
}
/* 压平后阶段行直接落在白卡上，meta 用一条细分隔线收尾，不再套一层灰块。
   数字用等宽，避免「下次安排」这类变宽数字在列表滚动时抖动——与时间表的 .hour/.event-time 一致。 */
.card-meta {
  padding-top: 10px;
  border-top: 1px solid rgba(219, 224, 232, .6);
  font-size: 12px;
  line-height: 18px;
  color: #3f4752;
  font-variant-numeric: tabular-nums;
}
/* 阶段与状态合成一句：「简历初筛 · 筛选中」，两者同字号同字重、状态用 tone 色。
   状态不再是挂在行尾的小字，读的时候和阶段是同一个「当前状态」短语。 */
.card-state {
  display: flex;
  align-items: center;
  gap: 6px;
  min-width: 0;
}
.card-state .stage-name {
  min-width: 0;
  overflow: hidden;
  text-overflow: ellipsis;
  white-space: nowrap;
}
.stage-sep {
  flex-shrink: 0;
  font-size: 14px;
  line-height: 20px;
  color: #6f7a8c;
}
.application-card .stage-name {
  font-size: 14px;
  line-height: 20px;
}
.application-card .status-badge {
  flex-shrink: 0;
  font-size: 14px;
  font-weight: 700;
  line-height: 20px;
}

/* The native input needs the full field height so its caret is not clipped on devices. */
.career-page .search {
  display: flex;
  align-items: center;
  gap: 8px;
  height: 43px;
  padding: 0 12px;
  box-sizing: border-box;
  border-radius: 10px;
  background: #fff;
}
.career-page .search input {
  display: block;
  flex: 1;
  min-width: 0;
  height: 43px;
  min-height: 0;
  padding: 0;
  margin: 0;
  box-sizing: border-box;
  border: 0;
  border-radius: 0;
  background: transparent;
  font-size: 13px;
  line-height: normal;
}

/* 「面试安排 / 求职记录」切换过渡：内容从对应方向淡入，导航指示线缩放展开。
   两个 tab 各自引用不同的 @keyframes，切换时动画名随之改变才会重新播放。 */
@keyframes career-tab-in-from-left {
  from { opacity: 0; transform: translateX(-16px); }
  to { opacity: 1; transform: translateX(0); }
}
@keyframes career-tab-in-from-right {
  from { opacity: 0; transform: translateX(16px); }
  to { opacity: 1; transform: translateX(0); }
}
@keyframes career-underline-in {
  from { opacity: 0; transform: scaleX(.4); }
  to { opacity: 1; transform: scaleX(1); }
}

@media (prefers-reduced-motion: reduce) {
  .schedule-body,
  .applications-body,
  .underline { animation: none; }
  .nav-item { transition: none; }
}
