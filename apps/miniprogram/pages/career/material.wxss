@import "./shared.wxss";
.with-tabs {
  padding-bottom: calc(78px + env(safe-area-inset-bottom));
}
.material-page .panel {
  padding: 16px;
  display: flex;
  flex-direction: column;
  gap: 10px;
  margin-bottom: 12px;
}
.material-page .title {
  font-size: 22px;
  line-height: 30px;
}
.material-page .heading {
  font-size: 17px;
  line-height: 25px;
}
.material-page .subtitle {
  font-size: 13px;
  line-height: 21px;
}
/* Two classes deep so these beat `.material-page .panel`. */
.material-page .job-hero { gap: 14px; padding: 16px; }
.hero-head { display:flex; align-items:center; gap:16px; min-width:0; }
.hero-copy { display:flex; flex-direction:column; gap:4px; flex:1; min-width:0; }
.hero-rule { height:1px; background:#dbe0e8; }
.hero-facts { display:flex; flex-direction:column; gap:6px; }
.hero-facts .hint { font-size:13px; line-height:21px; }
.salary {
  font-size: 13px;
  color: #145ed6;
  line-height: 21px;
}
.body-copy {
  font-size: 13px;
  line-height: 21px;
  white-space: pre-wrap;
  overflow-wrap: anywhere;
  color: #3f4752;
}
.skills {
  font-size: 13px;
  line-height: 21px;
  color: #145ed6;
}
.fact {
  display: flex;
  align-items: flex-start;
  gap: 16px;
  font-size: 13px;
  line-height: 21px;
}
.fact-label {
  width: 80px;
  flex-shrink: 0;
  color: #6f7a8c;
}
.fact-value {
  flex: 1;
  min-width: 0;
  color: #3f4752;
  white-space: pre-wrap;
  overflow-wrap: anywhere;
}
.resume-preview {
  display: block;
  width: 100%;
  margin-top: 16px;
}
