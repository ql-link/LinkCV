.page {
  min-height: 100vh;
  display: flex;
  align-items: center;
  justify-content: center;
  background: #f7f7f7;
  padding: 32rpx;
  box-sizing: border-box;
}

.card {
  width: 100%;
  max-width: 560rpx;
  background: #ffffff;
  border-radius: 24rpx;
  padding: 48rpx 40rpx;
  box-shadow: 0 8rpx 32rpx rgba(0, 0, 0, 0.06);
  box-sizing: border-box;
}

.logo {
  font-size: 40rpx;
  font-weight: 600;
  text-align: center;
  margin-bottom: 16rpx;
}

.title {
  font-size: 36rpx;
  font-weight: 600;
  text-align: center;
}

.subtitle {
  font-size: 26rpx;
  color: #888888;
  text-align: center;
  margin-top: 8rpx;
  margin-bottom: 40rpx;
}

.form {
  display: flex;
  flex-direction: column;
  align-items: center;
}

.avatar-button {
  width: 160rpx;
  height: 160rpx;
  padding: 0;
  border-radius: 50%;
  overflow: hidden;
  background: #f0f0f0;
  line-height: 1;
  display: flex;
  align-items: center;
  justify-content: center;
  margin-bottom: 32rpx;
}

.avatar-button::after {
  border: none;
}

.avatar-image {
  width: 100%;
  height: 100%;
}

.avatar-placeholder {
  font-size: 24rpx;
  color: #999999;
}

.nickname-input {
  width: 100%;
  height: 88rpx;
  background: #f5f5f5;
  border-radius: 16rpx;
  padding: 0 24rpx;
  font-size: 28rpx;
  box-sizing: border-box;
  margin-bottom: 32rpx;
}

.confirm-button {
  width: 100%;
  height: 88rpx;
  border-radius: 16rpx;
  font-size: 30rpx;
}

.error {
  margin-top: 24rpx;
  font-size: 26rpx;
  color: #e64340;
  text-align: center;
}

.done {
  display: flex;
  flex-direction: column;
  align-items: center;
  padding: 48rpx 0 24rpx;
}

.done-icon {
  width: 96rpx;
  height: 96rpx;
  border-radius: 50%;
  background: #07c160;
  color: #ffffff;
  font-size: 52rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  margin-bottom: 24rpx;
}

.done-title {
  font-size: 32rpx;
  font-weight: 600;
}

.done-subtitle {
  font-size: 26rpx;
  color: #888888;
  margin-top: 8rpx;
}
