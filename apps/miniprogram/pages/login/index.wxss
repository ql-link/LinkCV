/* pages/login/index.wxss */
/* LinkResume 授权确认页（强质感背景版）样式。
   背景由"微渐变 + 巨型品牌水印 + 中心聚焦光晕 + 底部网格"四层构成，
   色调极浅、对比度低，只提供质感与层次，不干扰前景信息。 */

page {
  /* ===== 设计变量（Design Tokens）===== */
  --ink: #1a1a1a;          /* 主文字、主按钮背景、水印 */
  --bg-start: #fafaf8;     /* 背景渐变起点（极浅暖灰） */
  --bg-end: #f2f2f0;       /* 背景渐变终点（极浅冷灰） */
  --muted: #666666;        /* Slogan 文字 */
  --light: #999999;        /* 授权说明文字、右上角声明 */
  --primary: #cc785c;      /* 陶土红——装饰线、按钮按压态、光晕 */
  --font-serif: "Cormorant Garamond", "Times New Roman", serif; /* 品牌名 */
  --font-sans: -apple-system, BlinkMacSystemFont, "SF Pro", "Inter", sans-serif; /* 正文 */

  /* 第一层：微渐变底色，从上到下由暖灰到冷灰，模拟纸张质感 */
  background: linear-gradient(to bottom, var(--bg-start) 0%, var(--bg-end) 100%);
  color: var(--ink);
  font-family: var(--font-sans);
}

/* 页面根容器：flex 纵向排列，内容居中；底部为固定按钮预留高度 */
.page {
  position: relative; /* 作为背景装饰绝对定位的参照 */
  min-height: 100vh;
  display: flex;
  flex-direction: column;
  padding-bottom: calc(184rpx + constant(safe-area-inset-bottom));
  padding-bottom: calc(184rpx + env(safe-area-inset-bottom));
  box-sizing: border-box;
  overflow: hidden;
}

/* ===== 背景装饰层（不可点击，z-index 0，置于所有内容之下）===== */
.bg-deco {
  position: absolute;
  top: 0;
  left: 0;
  right: 0;
  bottom: 0;
  z-index: 0;
  overflow: hidden; /* 裁剪越界装饰，避免产生滚动条 */
}

/* 第二层：巨型品牌水印 —— 几乎不可见的 "L"，仅作为纹理存在 */
.deco-watermark {
  position: absolute;
  top: 54%; /* 页面中心偏下 */
  left: 50%;
  font-family: var(--font-serif);
  font-size: 1200rpx; /* 约 600px 高 */
  font-weight: 900;
  line-height: 1;
  color: var(--ink);
  opacity: 0.03; /* 透明度 3%，不具备可读性 */
  transform: translate(-50%, -50%);
}

/* 第三层：中心聚焦光晕 —— 柔和径向渐变，舞台聚光灯效果 */
.deco-glow {
  position: absolute;
  top: 50%;
  left: 50%;
  width: 1200rpx; /* 600px */
  height: 800rpx; /* 400px */
  transform: translate(-50%, -50%);
  /* 中心陶土红 8%，边缘完全透明 */
  background: radial-gradient(
    ellipse at center,
    rgba(204, 120, 92, 0.08) 0%,
    rgba(204, 120, 92, 0) 70%
  );
}

/* 第四层：底部点阵网格纹理 —— 细微圆点阵列 */
.deco-grid {
  position: absolute;
  left: 0;
  right: 0;
  bottom: 0;
  height: 240rpx;
  background-image: radial-gradient(circle, rgba(26, 26, 26, 0.03) 2rpx, transparent 2rpx);
  background-size: 48rpx 48rpx; /* 点间距 24px */
}

/* ===== 自定义导航栏（无返回/退出入口，仅右上角声明）===== */
.nav {
  position: relative;
  z-index: 1; /* 置于背景装饰之上 */
  height: 112rpx; /* 56px */
  display: flex;
  align-items: center;
  justify-content: flex-end;
  padding: 0 40rpx; /* 20px */
  box-sizing: border-box;
}

/* 右上角服务来源声明：极小、弱化、右对齐，延迟淡入 */
.service-provider {
  max-width: 400rpx;
  font-size: 20rpx; /* 10px */
  font-weight: 400;
  color: #bbbbbb;
  text-align: right;
  line-height: 112rpx;
  /* 进入动效：opacity 0 → 1，延迟 0.3s */
  animation: providerIn 0.3s ease-out 0.3s both;
}

@keyframes providerIn {
  from {
    opacity: 0;
  }
  to {
    opacity: 1;
  }
}

/* ===== 核心内容区：剩余高度中完全垂直居中，置于装饰之上 ===== */
.content {
  position: relative;
  z-index: 1;
  flex: 1;
  display: flex;
  flex-direction: column;
  align-items: center;
  justify-content: center;
  padding: 80rpx 48rpx; /* 40px */
  box-sizing: border-box;
  /* 页面进入动效：淡入 + 上浮 16px，0.4s 缓出 */
  animation: fadeUp 0.4s ease-out;
}

@keyframes fadeUp {
  from {
    opacity: 0;
    transform: translateY(16px);
  }
  to {
    opacity: 1;
    transform: translateY(0);
  }
}

/* 品牌徽章：深色圆底 + 外围极淡描边（徽章质感）+ 白色大写字母 L */
.brand-icon {
  width: 144rpx; /* 72px */
  height: 144rpx;
  border-radius: 50%;
  background: var(--ink);
  /* 外围一圈极淡描边，形成"徽章"质感 */
  box-shadow: 0 0 0 2rpx #e0dcd6;
  color: var(--white, #ffffff);
  font-size: 64rpx; /* 32px */
  font-weight: 600;
  display: flex;
  align-items: center;
  justify-content: center;
  /* Logo 动效：轻微缩放入场，0.45s */
  animation: logoIn 0.45s ease-out;
}

@keyframes logoIn {
  from {
    transform: scale(0.9);
  }
  to {
    transform: scale(1);
  }
}

/* 品牌名称：衬线字体、宽字距 */
.brand-name {
  margin-top: 32rpx; /* 16px */
  font-family: var(--font-serif);
  font-size: 56rpx; /* 28px */
  font-weight: 400;
  letter-spacing: 2rpx; /* 1px */
  color: var(--ink);
}

/* 陶土红装饰线：页面唯一强彩色元素，两端略微变细（锥形收尾） */
.decor-line {
  margin-top: 28rpx; /* 14px */
  width: 80rpx; /* 40px */
  height: 4rpx; /* 2px */
  border-radius: 4rpx;
  /* 两端渐变透明实现锥形收尾，增加手工感 */
  background: linear-gradient(
    to right,
    rgba(204, 120, 92, 0) 0%,
    var(--primary) 15%,
    var(--primary) 85%,
    rgba(204, 120, 92, 0) 100%
  );
  /* 展开动效：宽度 0 → 80rpx，延迟 0.15s 启动，动画结束后保持最终宽度 */
  animation: expand 0.3s ease-out 0.15s both;
}

@keyframes expand {
  from {
    width: 0;
  }
  to {
    width: 80rpx;
  }
}

/* Slogan */
.brand-tagline {
  margin-top: 28rpx; /* 14px */
  font-size: 28rpx; /* 14px */
  font-weight: 400;
  color: var(--muted);
}

/* ===== 底部操作区：fixed 吸底，主按钮 + 按钮下方授权说明 ===== */
.footer {
  position: fixed;
  left: 0;
  right: 0;
  bottom: 0;
  z-index: 10;
  padding: 0 64rpx; /* 32px */
  padding-bottom: calc(24rpx + constant(safe-area-inset-bottom));
  padding-bottom: calc(24rpx + env(safe-area-inset-bottom));
  /* 背景透明，露出底部的点阵网格纹理 */
}

/* 主按钮"确认登录"：纯黑、大圆角，右侧带箭头，按压平滑过渡为陶土红 */
.btn-main {
  display: flex;
  align-items: center;
  justify-content: center;
  width: 100%;
  height: 104rpx; /* 52px */
  padding: 0;
  margin: 0;
  background: var(--ink);
  border-radius: 52rpx; /* 26px */
  color: var(--white, #ffffff);
  transition: background 0.2s ease;
}

/* 重置微信 button 默认边框 */
.btn-main::after {
  border: none;
}

/* 按压态：背景平滑过渡为陶土红，松开恢复纯黑 */
.btn-pressed {
  background: var(--primary);
}

.btn-text {
  font-size: 34rpx; /* 17px */
  font-weight: 500;
  line-height: 104rpx;
}

.btn-arrow {
  margin-left: 12rpx;
  font-size: 30rpx;
  line-height: 104rpx;
}

/* 提交中禁用态：降低透明度避免重复点击 */
.btn-main[disabled] {
  opacity: 0.6;
}

/* "取消"小字：提供取消/拒绝返回选项，满足审核"不得强制授权"规范 */
.btn-cancel {
  margin-top: 28rpx; /* 14px */
  padding: 8rpx 0; /* 扩大点击热区 */
  text-align: center;
  font-size: 28rpx; /* 14px */
  font-weight: 400;
  color: #888888;
}

.btn-cancel-hover {
  opacity: 0.6;
}

/* 模式说明：浏览模式 / 授权模式共用，浅灰小字，居中 */
.mode-note {
  margin-top: 40rpx; /* 20px */
  padding: 0 40rpx;
  text-align: center;
  font-size: 24rpx; /* 12px */
  font-weight: 400;
  color: var(--light);
  line-height: 1.6;
}
