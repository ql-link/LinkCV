<view class="page">
  <view class="topbar">
    <view class="ui-brand">
      <image class="ui-brand-mark" src="/assets/linkcv-mark.png" mode="aspectFit" aria-hidden="true"></image>
      <text>LinkCV</text>
    </view>
  </view>
  <view class="content">
    <text class="title" wx:if="{{!accountStatusReady}}">识别微信账号</text>
    <text class="title" wx:elif="{{accountRegistered}}">登录 LinkCV</text>
    <text class="title" wx:else>注册 LinkCV</text>
    <view class="status-line">
      <view class="status-indicator" wx:if="{{loading || submitting}}">
        <view class="spinner"></view>
      </view>
      <text class="status-message" wx:if="{{loading || submitting}}">{{message}}</text>
      <text class="status-message" wx:else>{{message}}</text>
    </view>
    <view class="consent">
      <checkbox-group bindchange="handleAgreementChange">
        <label class="agreement-row">
          <checkbox class="agreement-checkbox" value="accepted" checked="{{agreementAccepted}}" color="#145ed6" />
          <text class="agreement-copy">我已阅读并同意<text class="agreement-link" catchtap="openPrivacyContract">{{privacyContractName}}</text></text>
        </label>
      </checkbox-group>
      <text class="agreement-hint" wx:if="{{!privacyReady}}">正在读取隐私保护指引…</text>
      <text class="agreement-hint" wx:elif="{{!privacySupported}}">当前微信版本无法读取隐私指引，请升级微信后重试</text>
      <text class="agreement-hint" wx:elif="{{agreementActionHint}}">{{agreementActionHint}}</text>
    </view>
    <view class="actions">
      <button
        wx:if="{{privacyAuthorizationRequired}}"
        id="agree-btn"
        class="ui-primary-button"
        hover-class="ui-primary-button-pressed"
        open-type="agreePrivacyAuthorization"
        bindagreeprivacyauthorization="handlePrivacyAuthorization"
        disabled="{{submitting || !privacyReady || !privacySupported || !agreementAccepted || !accountStatusReady}}"
      >{{submitting ? '正在处理…' : accountRegistered ? '同意并登录' : '同意并注册'}}</button>
      <button
        wx:else
        class="ui-primary-button"
        hover-class="ui-primary-button-pressed"
        bindtap="handlePrimaryAction"
        disabled="{{submitting || !privacyReady || !privacySupported || !agreementAccepted || !accountStatusReady}}"
      >{{submitting ? '正在处理…' : accountRegistered ? '同意并登录' : '同意并注册'}}</button>
      <button class="ui-secondary-button" hover-class="ui-secondary-button-pressed" bindtap="loadAccountStatus" disabled="{{submitting}}" wx:if="{{accountStatusError}}">重新识别账号</button>
      <button class="ui-secondary-button" hover-class="ui-secondary-button-pressed" bindtap="handleDismiss" disabled="{{submitting}}">暂不登录</button>
    </view>
  </view>
  <view class="privacy-note">微信身份仅用于登录和保护你的简历数据</view>
</view>
