<view class="page">
  <view class="bg-deco">
    <view class="deco-watermark">L</view>
    <view class="deco-glow"></view>
    <view class="deco-grid"></view>
  </view>
  <view class="nav"><text class="service-provider">相关服务由 LinkCV 小程序提供</text></view>
  <view class="content">
    <view class="brand-icon">L</view>
    <view class="brand-name">LinkCV</view>
    <view class="decor-line"></view>
    <view class="brand-tagline">安全确认网页登录</view>
    <view class="mode-note">{{message}}</view>
  </view>
  <view class="footer" wx:if="{{phase === 'pending'}}">
    <button class="btn-main" hover-class="btn-pressed" bindtap="handleConfirm" disabled="{{submitting}}">
      <view class="btn-text">{{submitting ? '正在处理…' : '确认登录'}}</view>
      <view class="btn-arrow">→</view>
    </button>
    <view class="btn-cancel" hover-class="btn-cancel-hover" bindtap="handleCancel">取消本次登录</view>
  </view>
  <view class="footer" wx:elif="{{phase === 'confirmed' || phase === 'cancelled'}}">
    <button class="btn-main" bindtap="openResumes">查看我的简历</button>
  </view>
</view>
