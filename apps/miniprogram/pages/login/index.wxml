<view class="canvas">
  <view class="canvas-grid"></view>
  <view class="topbar">
    <view class="brand">
      <view class="brand-mark">L</view>
      <view class="brand-copy">
        <text class="brand-name">LinkCV</text>
        <text class="brand-sub">随 身 简 历 册</text>
      </view>
    </view>
    <text class="topbar-tag">SIGN IN</text>
  </view>
  <view class="content">
    <view class="head">
      <text class="kicker">LINKCV · WECHAT LOGIN</text>
      <text class="head-title" wx:if="{{!accountStatusReady}}">识别微信账号</text>
      <text class="head-title" wx:elif="{{accountRegistered}}">登录 LinkCV</text>
      <text class="head-title" wx:else>注册 LinkCV</text>
    </view>
    <view class="status-card paper-card">
      <view class="status-indicator">
        <view class="spinner" wx:if="{{loading || submitting}}"></view>
        <text wx:else>·</text>
      </view>
      <text class="status-message">{{message}}</text>
    </view>
    <view class="consent">
      <checkbox-group bindchange="handleAgreementChange">
        <label class="agreement-row">
          <checkbox class="agreement-checkbox" value="accepted" checked="{{agreementAccepted}}" color="#18181b" />
          <view class="agreement-copy">我已阅读并同意 <text class="agreement-link" catchtap="openPrivacyContract">{{privacyContractName}}</text></view>
        </label>
      </checkbox-group>
      <text class="agreement-hint" wx:if="{{!privacyReady}}">正在读取隐私保护指引…</text>
      <text class="agreement-hint" wx:elif="{{!privacySupported}}">当前微信版本无法读取隐私指引，请升级微信后重试</text>
      <text class="agreement-hint" wx:elif="{{!agreementAccepted}}">勾选后才能继续</text>
    </view>
    <view class="actions">
      <button
        wx:if="{{privacyAuthorizationRequired}}"
        id="agree-btn"
        class="btn-primary"
        hover-class="btn-primary-pressed"
        open-type="agreePrivacyAuthorization"
        bindagreeprivacyauthorization="handlePrivacyAuthorization"
        disabled="{{submitting || !privacyReady || !privacySupported || !agreementAccepted || !accountStatusReady}}"
      >{{submitting ? '正在处理…' : accountRegistered ? '同意并登录' : '同意并注册'}}</button>
      <button
        wx:else
        class="btn-primary"
        hover-class="btn-primary-pressed"
        bindtap="handlePrimaryAction"
        disabled="{{submitting || !privacyReady || !privacySupported || !agreementAccepted || !accountStatusReady}}"
      >{{submitting ? '正在处理…' : accountRegistered ? '同意并登录' : '同意并注册'}}</button>
      <button class="btn-ghost" wx:if="{{accountStatusError}}" hover-class="btn-ghost-pressed" bindtap="loadAccountStatus" disabled="{{submitting}}">重新识别账号</button>
      <button class="btn-ghost" hover-class="btn-ghost-pressed" bindtap="handleDismiss" disabled="{{submitting}}">暂不登录</button>
    </view>
  </view>
  <view class="footnote">微信身份仅用于登录和保护你的简历数据</view>
</view>
