<view class="page" style="padding-top: calc({{statusBarHeight}}px + 12rpx)">
  <view class="topbar">
    <view class="close-button" hover-class="close-button-pressed" bindtap="handleDismiss" wx:if="{{!submitting}}" role="button" aria-label="暂不登录，返回首页">
      <icon type="cancel" size="22" color="#17191c"></icon>
    </view>
  </view>

  <view class="content">
    <view class="identity">
      <view class="brand-card">
        <image class="brand-mark" src="/assets/linkresume-mark.png" mode="aspectFit" aria-label="LinkCV"></image>
      </view>
      <text class="title" wx:if="{{!accountStatusReady}}">识别微信账号</text>
      <text class="title" wx:elif="{{accountRegistered}}">欢迎回来</text>
      <text class="title" wx:else>开启职场新篇章</text>
      <text class="subtitle" wx:if="{{loading || submitting || accountStatusError}}">{{message}}</text>
      <text class="subtitle" wx:elif="{{accountRegistered}}">登录 LinkCV，继续管理你的职业履历</text>
      <text class="subtitle" wx:else>创建一个账户，发现更多职业机遇</text>
      <view class="inline-status" wx:if="{{loading || submitting}}"><view class="spinner"></view></view>
    </view>

    <view class="actions">
      <button
        wx:if="{{privacyAuthorizationRequired}}"
        id="agree-btn"
        class="ui-primary-button auth-primary-button"
        hover-class="auth-primary-button-pressed"
        open-type="agreePrivacyAuthorization"
        bindagreeprivacyauthorization="handlePrivacyAuthorization"
        disabled="{{submitting || !privacyReady || !privacySupported || !agreementAccepted || !accountStatusReady}}"
      >{{submitting ? '正在处理…' : accountRegistered ? '微信快捷登录' : '微信快捷注册'}}</button>
      <button
        wx:else
        class="ui-primary-button auth-primary-button"
        hover-class="auth-primary-button-pressed"
        bindtap="handlePrimaryAction"
        disabled="{{submitting || !privacyReady || !privacySupported || !agreementAccepted || !accountStatusReady}}"
      >{{submitting ? '正在处理…' : accountRegistered ? '微信快捷登录' : '微信快捷注册'}}</button>
      <button class="retry-button" hover-class="retry-button-pressed" bindtap="loadAccountStatus" disabled="{{submitting}}" wx:if="{{accountStatusError}}">重新识别账号</button>
    </view>

    <view class="consent">
      <checkbox-group bindchange="handleAgreementChange">
        <label class="agreement-row">
          <checkbox class="agreement-checkbox" value="accepted" checked="{{agreementAccepted}}" color="#17191c" />
          <text class="agreement-copy">阅读并同意<text class="agreement-link" catchtap="openPrivacyContract">{{privacyContractName}}</text></text>
        </label>
      </checkbox-group>
      <text class="agreement-hint" wx:if="{{!privacyReady}}">正在读取隐私保护指引…</text>
      <text class="agreement-hint" wx:elif="{{!privacySupported}}">当前微信版本无法读取隐私指引，请升级微信后重试</text>
      <text class="agreement-hint" wx:elif="{{agreementActionHint}}">{{agreementActionHint}}</text>
    </view>
  </view>
</view>
