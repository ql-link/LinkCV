/* All three tabs share the career navigation geometry and exported glyphs. */
.tab-bar {
  position: fixed;
  bottom: 0;
  left: 0;
  right: 0;
  height: 54px;
  padding-bottom: env(safe-area-inset-bottom);
  background: #fff;
  display: flex;
  z-index: 999999;
}
.tab-bar-item {
  flex: 1;
  display: flex;
  flex-direction: column;
  align-items: center;
  justify-content: flex-start;
  padding-top: 8px;
  text-align: center;
  touch-action: manipulation;
}
.tab-icon-wrap { display: flex; align-items: center; justify-content: center; width: 24px; height: 24px; transition: transform 140ms ease-out; }
.tab-icon { display: block; width: 21px; height: 21px; transform: scale(.79); transition: transform 160ms ease-out; }
.tab-bar-item.is-active .tab-icon { transform: scale(1); }
.tab-bar-item-hover .tab-icon-wrap { transform: scale(1.12); }
.tab-bar-item-hover .tab-label { color: #17191c; }
.tab-label {
  margin-top: 1px;
  font-family: "LinkResume Career UI", -apple-system, sans-serif;
  font-size: 11px;
  line-height: 1.45;
  font-weight: 400;
  letter-spacing: 0;
  color: #8993a2;
  transition: color 160ms ease-out;
}
.tab-label.is-active { color: #17191c; font-weight: 700; }
