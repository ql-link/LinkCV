/* All three tabs share the career navigation geometry and exported glyphs. */
.tab-bar {
  position: fixed;
  bottom: 0;
  left: 0;
  right: 0;
  height: 54px;
  padding-bottom: env(safe-area-inset-bottom);
  background: #fff;
  display: flex;
  z-index: 999999;
}
.tab-bar-item {
  flex: 1;
  display: flex;
  flex-direction: column;
  align-items: center;
  justify-content: flex-start;
  padding-top: 12px;
  text-align: center;
  touch-action: manipulation;
}
.tab-bar-item-hover { opacity: .85; }
.tab-icon-wrap, .tab-icon { display: block; width: 18px; height: 18px; }
.tab-label {
  margin-top: 3px;
  font-family: "LinkCV Career UI", -apple-system, sans-serif;
  font-size: 11px;
  line-height: 1.45;
  font-weight: 400;
  letter-spacing: 0;
  color: #6f7a8c;
}
.tab-label.is-active { color: #17191c; font-weight: 600; }
